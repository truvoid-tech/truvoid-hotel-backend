@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "deep-navy": "#1f3864", "primary": "#03224d", "ink": "#101828",
                        "warm-gold": "#B8860B", "slate-gray": "#475467", "paper-white": "#FFFFFF",
                        "background": "#f7f9fc", "surface": "#f7f9fc", "surface-bright": "#f7f9fc",
                        "surface-dim": "#d8dadd", "surface-container": "#eceef1",
                        "surface-container-low": "#f2f4f7", "surface-container-high": "#e6e8eb",
                        "surface-container-highest": "#e0e3e6", "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e0e3e6", "surface-tint": "#475e8c",
                        "on-background": "#191c1e", "on-surface": "#191c1e",
                        "on-surface-variant": "#44474f", "on-primary": "#ffffff",
                        "on-secondary": "#ffffff", "on-tertiary": "#ffffff", "on-error": "#ffffff",
                        "primary-fixed": "#d8e2ff", "primary-fixed-dim": "#afc6fb",
                        "primary-container": "#1f3864", "on-primary-fixed": "#001a41",
                        "on-primary-fixed-variant": "#2e4673", "on-primary-container": "#8ba2d5",
                        "secondary": "#7b5800", "secondary-container": "#fdc34d",
                        "secondary-fixed": "#ffdea6", "secondary-fixed-dim": "#f7bd48",
                        "on-secondary-fixed": "#271900", "on-secondary-fixed-variant": "#5d4200",
                        "on-secondary-container": "#715000",
                        "tertiary": "#361e00", "tertiary-container": "#543100",
                        "tertiary-fixed": "#ffddbb", "tertiary-fixed-dim": "#f4bc7f",
                        "on-tertiary-fixed": "#2b1700", "on-tertiary-fixed-variant": "#643e0c",
                        "on-tertiary-container": "#cc995f",
                        "error": "#ba1a1a", "error-container": "#ffdad6", "on-error-container": "#93000a",
                        "outline": "#747780", "outline-variant": "#c4c6d0",
                        "inverse-primary": "#afc6fb", "inverse-surface": "#2d3133",
                        "inverse-on-surface": "#eff1f4",
                    },
                    borderRadius: { DEFAULT: "0.125rem", lg: "0.25rem", xl: "0.5rem", full: "0.75rem" },
                    spacing: {
                        "margin-desktop": "48px", gutter: "24px",
                        "section-gap": "64px", unit: "8px", "margin-mobile": "20px"
                    },
                    fontFamily: {
                        "body-sm": ["Public Sans"], "label-md": ["JetBrains Mono"],
                        "headline-lg": ["Public Sans"], "headline-md": ["Public Sans"],
                        "label-sm": ["JetBrains Mono"], "body-md": ["Public Sans"],
                        "headline-lg-mobile": ["Public Sans"], "display-lg": ["Public Sans"],
                        "body-lg": ["Public Sans"]
                    },
                    fontSize: {
                        "body-sm": ["14px", { lineHeight: "20px", fontWeight: "400" }],
                        "label-md": ["13px", { lineHeight: "20px", letterSpacing: "0.02em", fontWeight: "500" }],
                        "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.02em", fontWeight: "600" }],
                        "headline-md": ["24px", { lineHeight: "32px", letterSpacing: "-0.01em", fontWeight: "600" }],
                        "label-sm": ["11px", { lineHeight: "16px", letterSpacing: "0.05em", fontWeight: "500" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "headline-lg-mobile": ["26px", { lineHeight: "34px", letterSpacing: "-0.02em", fontWeight: "600" }],
                        "display-lg": ["48px", { lineHeight: "56px", letterSpacing: "-0.03em", fontWeight: "700" }],
                        "body-lg": ["18px", { lineHeight: "28px", letterSpacing: "-0.01em", fontWeight: "400" }]
                    }
                }
            }
        }
    </script>
    <style>
        .table-scroll::-webkit-scrollbar { height: 6px; }
        .table-scroll::-webkit-scrollbar-track { background: #f7f9fc; }
        .table-scroll::-webkit-scrollbar-thumb { background: #c4c6d0; border-radius: 4px; }
        .table-row-hover:hover { background-color: #f2f4f7; }
    </style>
</HeadContent>

<div class="bg-background text-on-surface font-body-md min-h-screen flex flex-col md:flex-row antialiased selection:bg-deep-navy selection:text-paper-white">

    <!-- Mobile Top Nav -->
    <header class="md:hidden flex justify-between items-center w-full px-margin-mobile h-16 bg-surface border-b border-outline-variant shrink-0">
        <div class="font-headline-md text-headline-md font-bold text-deep-navy">TruvoID</div>
        <div class="flex items-center gap-4 text-slate-gray">
            <span class="material-symbols-outlined cursor-pointer hover:text-deep-navy transition-colors">notifications</span>
            <span class="material-symbols-outlined cursor-pointer hover:text-deep-navy transition-colors">help_outline</span>
            <div class="w-8 h-8 rounded-full bg-surface-container border border-outline-variant flex items-center justify-center">
                <span class="material-symbols-outlined text-[18px]">person</span>
            </div>
        </div>
    </header>

    <!-- Desktop Sidebar -->
    <nav class="hidden md:flex flex-col h-screen w-64 bg-deep-navy py-unit gap-2 shrink-0 sticky top-0">

        <div class="px-6 py-6 mb-4 flex flex-col gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded bg-white/10 flex items-center justify-center border border-white/10">
                    <span class="material-symbols-outlined text-warm-gold text-[22px]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                </div>
                <span class="font-headline-md text-headline-md text-paper-white leading-tight">TruvoID</span>
            </div>
            <div>
                <h2 class="font-body-md text-body-md font-semibold text-paper-white">Institutional Panel</h2>
                <p class="font-label-sm text-label-sm text-on-primary/70 uppercase">Verification Authority</p>
            </div>
        </div>

        <div class="flex-1 flex flex-col gap-1 px-4">
            <a href="/dashboard" class="@(SideNavClass("/dashboard"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/dashboard"))">dashboard</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Dashboard</span>
            </a>
            <a href="/history" class="@(SideNavClass("/history"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/history"))">history</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">History</span>
            </a>
            <a href="/wallet" class="@(SideNavClass("/wallet"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/wallet"))">account_balance_wallet</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Wallet</span>
            </a>
            <a href="/team" class="@(SideNavClass("/team"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/team"))">group</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Team</span>
            </a>
            <a href="/settings" class="@(SideNavClass("/settings"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/settings"))">settings</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Settings</span>
            </a>
        </div>

        <div class="px-6 py-6 mt-auto">
            <button class="w-full bg-warm-gold text-paper-white font-label-md text-label-md uppercase tracking-wider py-3 rounded hover:opacity-90 transition-opacity flex justify-center items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">add</span>
                Replenish Balance
            </button>
        </div>
    </nav>

    <!-- Main Content Canvas -->
    <main class="flex-1 flex flex-col min-w-0 bg-background relative overflow-y-auto">

        <!-- Desktop Top App Bar -->
        <header class="hidden md:flex justify-between items-center w-full px-margin-desktop h-16 bg-surface border-b border-outline-variant shrink-0 sticky top-0 z-10">
            <div class="flex items-center gap-4 text-slate-gray">
                <span class="font-body-sm text-body-sm">Overview</span>
            </div>
            <div class="flex items-center gap-6">
                <button class="text-slate-gray hover:text-deep-navy transition-colors">
                    <span class="material-symbols-outlined">notifications</span>
                </button>
                <button class="text-slate-gray hover:text-deep-navy transition-colors">
                    <span class="material-symbols-outlined">help_outline</span>
                </button>
                <div class="h-8 w-px bg-outline-variant"></div>
                <div class="flex items-center gap-3 cursor-pointer">
                    <div class="flex flex-col items-end">
                        <span class="font-label-sm text-label-sm text-deep-navy uppercase">Admin User</span>
                        <span class="font-body-sm text-[10px] text-slate-gray">ID: 4892-A</span>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-surface-container border border-outline-variant flex items-center justify-center">
                        <span class="material-symbols-outlined text-slate-gray text-[18px]">person</span>
                    </div>
                </div>
            </div>
        </header>

        @Body

        <!-- Compliance Footer -->
        <footer class="mt-auto border-t border-outline-variant bg-surface-container-low px-margin-mobile md:px-margin-desktop py-6">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-3 opacity-60 grayscale">
                    <span class="material-symbols-outlined text-deep-navy">policy</span>
                    <span class="font-label-sm text-[10px] text-slate-gray max-w-xl leading-relaxed">
                        MANDATORY COMPLIANCE NOTICE: TruvoID operates as an authorized NIMC reseller. All identity verification requests are logged and subject to audit. Unauthorized access or misuse of this panel is strictly prohibited and subject to legal prosecution under the NDPR and applicable federal laws.
                    </span>
                </div>
                <div class="font-label-sm text-label-sm text-slate-gray whitespace-nowrap">V 2.4.1 (Stable)</div>
            </div>
        </footer>
    </main>

    <!-- Mobile Bottom Nav -->
    <nav class="md:hidden flex justify-around items-center w-full h-16 bg-surface border-t border-outline-variant shrink-0 fixed bottom-0 left-0 z-50">
        <a href="/dashboard" class="flex flex-col items-center justify-center w-full h-full @(IsActive("/dashboard") ? "text-warm-gold border-t-2 border-warm-gold" : "text-slate-gray hover:text-deep-navy")">
            <span class="material-symbols-outlined" style="@(ActiveFill("/dashboard"))">dashboard</span>
            <span class="text-[10px] font-label-sm mt-1">Dashboard</span>
        </a>
        <a href="/history" class="flex flex-col items-center justify-center w-full h-full @(IsActive("/history") ? "text-warm-gold border-t-2 border-warm-gold" : "text-slate-gray hover:text-deep-navy")">
            <span class="material-symbols-outlined">history</span>
            <span class="text-[10px] font-label-sm mt-1">History</span>
        </a>
        <a href="/wallet" class="flex flex-col items-center justify-center w-full h-full @(IsActive("/wallet") ? "text-warm-gold border-t-2 border-warm-gold" : "text-slate-gray hover:text-deep-navy")">
            <span class="material-symbols-outlined">account_balance_wallet</span>
            <span class="text-[10px] font-label-sm mt-1">Wallet</span>
        </a>
        <a href="/settings" class="flex flex-col items-center justify-center w-full h-full @(IsActive("/settings") ? "text-warm-gold border-t-2 border-warm-gold" : "text-slate-gray hover:text-deep-navy")">
            <span class="material-symbols-outlined">settings</span>
            <span class="text-[10px] font-label-sm mt-1">Settings</span>
        </a>
    </nav>
    <div class="h-16 md:hidden w-full shrink-0"></div>
</div>

@code {
    private bool IsActive(string prefix)
    {
        var path = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    }

    private string ActiveFill(string prefix) =>
        IsActive(prefix) ? "font-variation-settings: 'FILL' 1;" : "";

    private string SideNavClass(string prefix) => IsActive(prefix)
        ? "flex items-center gap-3 px-4 py-3 text-warm-gold font-bold bg-white/5 border-l-4 border-warm-gold rounded-r-DEFAULT cursor-pointer active:scale-95 hover:bg-white/10 transition-all duration-200"
        : "flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary cursor-pointer active:scale-95 hover:bg-white/10 transition-all duration-200 border-l-4 border-transparent rounded-r-DEFAULT";
}
