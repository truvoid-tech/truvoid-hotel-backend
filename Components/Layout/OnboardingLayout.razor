@inherits LayoutComponentBase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "deep-navy": "#1f3864", "primary": "#03224d", "ink": "#101828",
                        "warm-gold": "#B8860B", "slate-gray": "#475467", "paper-white": "#FFFFFF",
                        "background": "#f7f9fc", "surface": "#f7f9fc", "surface-bright": "#f7f9fc",
                        "surface-dim": "#d8dadd", "surface-container": "#eceef1",
                        "surface-container-low": "#f2f4f7", "surface-container-high": "#e6e8eb",
                        "surface-container-highest": "#e0e3e6", "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e0e3e6", "surface-tint": "#475e8c",
                        "on-background": "#191c1e", "on-surface": "#191c1e",
                        "on-surface-variant": "#44474f", "on-primary": "#ffffff",
                        "on-secondary": "#ffffff", "on-tertiary": "#ffffff", "on-error": "#ffffff",
                        "primary-fixed": "#d8e2ff", "primary-fixed-dim": "#afc6fb",
                        "primary-container": "#1f3864", "on-primary-fixed": "#001a41",
                        "on-primary-fixed-variant": "#2e4673", "on-primary-container": "#8ba2d5",
                        "secondary": "#7b5800", "secondary-container": "#fdc34d",
                        "secondary-fixed": "#ffdea6", "secondary-fixed-dim": "#f7bd48",
                        "on-secondary-fixed": "#271900", "on-secondary-fixed-variant": "#5d4200",
                        "on-secondary-container": "#715000",
                        "tertiary": "#361e00", "tertiary-container": "#543100",
                        "tertiary-fixed": "#ffddbb", "tertiary-fixed-dim": "#f4bc7f",
                        "on-tertiary-fixed": "#2b1700", "on-tertiary-fixed-variant": "#643e0c",
                        "on-tertiary-container": "#cc995f",
                        "error": "#ba1a1a", "error-container": "#ffdad6", "on-error-container": "#93000a",
                        "outline": "#747780", "outline-variant": "#c4c6d0",
                        "inverse-primary": "#afc6fb", "inverse-surface": "#2d3133",
                        "inverse-on-surface": "#eff1f4",
                    },
                    borderRadius: {
                        DEFAULT: "0.125rem", lg: "0.25rem", xl: "0.5rem", full: "0.75rem"
                    },
                    spacing: {
                        "margin-desktop": "48px", gutter: "24px",
                        "section-gap": "64px", unit: "8px", "margin-mobile": "20px"
                    },
                    fontFamily: {
                        "body-sm": ["Public Sans"], "label-md": ["JetBrains Mono"],
                        "headline-lg": ["Public Sans"], "headline-md": ["Public Sans"],
                        "label-sm": ["JetBrains Mono"], "body-md": ["Public Sans"],
                        "headline-lg-mobile": ["Public Sans"], "display-lg": ["Public Sans"],
                        "body-lg": ["Public Sans"]
                    },
                    fontSize: {
                        "body-sm": ["14px", { lineHeight: "20px", fontWeight: "400" }],
                        "label-md": ["13px", { lineHeight: "20px", letterSpacing: "0.02em", fontWeight: "500" }],
                        "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.02em", fontWeight: "600" }],
                        "headline-md": ["24px", { lineHeight: "32px", letterSpacing: "-0.01em", fontWeight: "600" }],
                        "label-sm": ["11px", { lineHeight: "16px", letterSpacing: "0.05em", fontWeight: "500" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "headline-lg-mobile": ["26px", { lineHeight: "34px", letterSpacing: "-0.02em", fontWeight: "600" }],
                        "display-lg": ["48px", { lineHeight: "56px", letterSpacing: "-0.03em", fontWeight: "700" }],
                        "body-lg": ["18px", { lineHeight: "28px", letterSpacing: "-0.01em", fontWeight: "400" }]
                    }
                }
            }
        }
    </script>
</HeadContent>

@Body
