@page "/admin/admins"
@rendermode InteractiveServer
@layout AdminLayout
@namespace TruvoID.Components.AdminPages
@inject ApiClient Api

<AdminAuthGuard />
<PageTitle>TruvoID — Admin Users</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-10 flex-1 flex flex-col gap-section-gap">

    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Admin Users</h1>
            <p class="font-body-sm text-body-sm text-slate-gray mt-1">Manage platform and institution admin accounts</p>
        </div>
        <button @onclick="ShowInviteModal" class="bg-deep-navy text-paper-white px-5 py-2.5 rounded font-label-md text-label-md uppercase flex items-center gap-2 hover:bg-primary transition-colors">
            <span class="material-symbols-outlined text-[18px]">person_add</span>
            Invite Admin
        </button>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
        </div>
    }
    else if (_admins.Any())
    {
        <div class="bg-paper-white border border-outline-variant rounded-xl overflow-hidden">
            <table class="w-full">
                <thead class="bg-surface-container-low border-b border-outline-variant">
                    <tr>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Name</th>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Email</th>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Role</th>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Status</th>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Last Login</th>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var admin in _admins)
                    {
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full @(admin.Role == "PlatformAdmin" ? "bg-warm-gold/20 border border-warm-gold/40" : "bg-surface-container border border-outline-variant") flex items-center justify-center">
                                        <span class="material-symbols-outlined @(admin.Role == "PlatformAdmin" ? "text-warm-gold" : "text-slate-gray") text-[16px]">@(admin.Role == "PlatformAdmin" ? "admin_panel_settings" : "person")</span>
                                    </div>
                                    <span class="font-body-sm text-body-sm text-on-surface font-medium">@admin.FullName</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">@admin.Email</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded font-label-sm text-label-sm @(admin.Role == "PlatformAdmin" ? "bg-warm-gold/10 text-warm-gold border border-warm-gold/30" : "bg-surface-container text-slate-gray border border-outline-variant")">
                                    @admin.Role
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded font-label-sm text-label-sm @(admin.IsActive ? "bg-green-50 text-green-700 border border-green-200" : "bg-surface-container text-slate-gray border border-outline-variant")">
                                    <span class="w-1.5 h-1.5 rounded-full @(admin.IsActive ? "bg-green-500" : "bg-slate-gray")"></span>
                                    @(admin.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">
                                @(admin.LastLoginAt?.ToString("dd MMM yyyy, HH:mm") ?? "Never")
                            </td>
                            <td class="px-6 py-4">
                                @if (admin.Role != "PlatformAdmin")
                                {
                                    <select class="border border-outline-variant rounded px-2 py-1 font-label-sm text-label-sm text-on-surface bg-paper-white focus:border-deep-navy outline-none cursor-pointer"
                                            @onchange="@(e => OnRoleChanged(admin.UserId, e))">
                                        <option value="Admin" selected="@(admin.Role == "Admin")">Admin</option>
                                        <option value="Staff" selected="@(admin.Role == "Staff")">Staff</option>
                                    </select>
                                }
                                else
                                {
                                    <span class="font-label-sm text-label-sm text-slate-gray">Protected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="bg-paper-white border border-outline-variant rounded-xl p-12 text-center">
            <span class="material-symbols-outlined text-slate-gray text-[48px]">group</span>
            <p class="font-body-sm text-body-sm text-slate-gray mt-4">No admin users found</p>
        </div>
    }

    @if (_inviteVisible)
    {
        <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" @onclick="HideInviteModal">
            <div class="bg-paper-white border border-outline-variant rounded-xl p-6 w-full max-w-md shadow-xl" @onclick:stopPropagation="true">
                <h2 class="font-headline-md text-headline-md text-on-surface mb-4">Invite Admin</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase">Full Name</label>
                        <input @bind="_inviteName" class="w-full border border-outline-variant rounded px-3 py-2 font-body-sm text-body-sm focus:border-deep-navy outline-none" placeholder="Jane Doe" />
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase">Email</label>
                        <input @bind="_inviteEmail" type="email" class="w-full border border-outline-variant rounded px-3 py-2 font-body-sm text-body-sm focus:border-deep-navy outline-none" placeholder="jane@truvoid.ng" />
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase">Password</label>
                        <input @bind="_invitePassword" type="password" class="w-full border border-outline-variant rounded px-3 py-2 font-body-sm text-body-sm focus:border-deep-navy outline-none" placeholder="••••••••" />
                    </div>
                    @if (!string.IsNullOrEmpty(_inviteError))
                    {
                        <div class="text-red-600 font-body-sm text-body-sm">@_inviteError</div>
                    }
                    <div class="flex gap-3 pt-2">
                        <button @onclick="HideInviteModal" class="flex-1 border border-outline-variant rounded py-2 font-label-md text-label-md uppercase hover:bg-surface-container-low">Cancel</button>
                        <button @onclick="SubmitInvite" disabled="@(_inviting)" class="flex-1 bg-deep-navy text-paper-white rounded py-2 font-label-md text-label-md uppercase hover:bg-primary disabled:opacity-50">
                            @(_inviting ? "Inviting..." : "Send Invite")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<AdminUserDto> _admins = [];
    private bool _loading = true;
    private bool _inviteVisible;
    private bool _inviting;
    private string? _inviteError;
    private string _inviteName = "";
    private string _inviteEmail = "";
    private string _invitePassword = "";
    private string? _roleError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAdmins();
    }

    private async Task LoadAdmins()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _admins = await Api.GetAsync<List<AdminUserDto>>("/v1/admin/admins") ?? [];
        }
        catch { }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ShowInviteModal()
    {
        _inviteVisible = true;
        _inviteError = null;
        _inviteName = "";
        _inviteEmail = "";
        _invitePassword = "";
    }

    private void HideInviteModal() => _inviteVisible = false;

    private async Task SubmitInvite()
    {
        _inviting = true;
        _inviteError = null;
        StateHasChanged();

        try
        {
            await Api.PostAsync("/v1/admin/admins/invite", new InviteAdminRequest
            {
                Email = _inviteEmail,
                FullName = _inviteName,
                Password = _invitePassword
            });
            _inviteVisible = false;
            await LoadAdmins();
        }
        catch (Exception ex)
        {
            _inviteError = ex.Message;
        }
        finally
        {
            _inviting = false;
            StateHasChanged();
        }
    }

    private async Task OnRoleChanged(Guid userId, ChangeEventArgs e)
    {
        var newRole = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(newRole)) return;

        try
        {
            await Api.PutAsync($"/v1/admin/admins/{userId}/role", new UpdateRoleRequest { Role = newRole });
            await LoadAdmins();
        }
        catch (Exception ex)
        {
            _roleError = ex.Message;
            StateHasChanged();
        }
    }
}
