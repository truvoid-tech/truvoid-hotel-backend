@page "/admin/nimc"
@rendermode InteractiveServer
@layout AdminLayout
@namespace TruvoID.Components.AdminPages
@inject ApiClient Api
@using TruvoID.Core.DTOs

<AdminAuthGuard />
<PageTitle>TruvoID — NIMC Configuration</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-10 flex-1 flex flex-col gap-section-gap">

    <!-- Header -->
    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">NIMC API Configuration</h1>
        <p class="font-body-sm text-body-sm text-slate-gray mt-1">Switch between Live and Sandbox verification environments</p>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
        </div>
    }
    else if (_error is not null)
    {
        <div class="flex items-center gap-3 p-4 bg-[#fce8e6] border border-[#f5c6c4] rounded text-[#c5221f]">
            <span class="material-symbols-outlined text-[18px]">error</span>
            <span class="font-body-sm text-body-sm">@_error</span>
        </div>
    }
    else
    {
        <!-- Active Environment Banner -->
        <div class="rounded-xl p-6 @(IsLive ? "bg-gradient-to-r from-red-50 to-red-100 border-2 border-red-200" : "bg-gradient-to-r from-green-50 to-green-100 border-2 border-green-200")">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-xl @(IsLive ? "bg-red-500" : "bg-green-500") flex items-center justify-center shadow-lg">
                        <span class="material-symbols-outlined text-white text-[28px]" style="font-variation-settings: 'FILL' 1;">@(IsLive ? "cell_tower" : "science")</span>
                    </div>
                    <div>
                        <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Active Environment</p>
                        <p class="font-headline-lg text-headline-lg font-bold @(IsLive ? "text-red-700" : "text-green-700")">@(IsLive ? "Live (Production)" : "Sandbox (Testing)")</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full @(IsLive ? "bg-red-500" : "bg-green-500") animate-pulse"></span>
                    <span class="font-label-sm text-label-sm uppercase tracking-wider @(IsLive ? "text-red-600" : "text-green-600")">Active</span>
                </div>
            </div>
        </div>

        <!-- Toggle Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            <!-- Sandbox Card -->
            <button @onclick="SwitchToSandbox"
                    class="text-left p-6 rounded-xl border-2 transition-all duration-200 @(IsLive ? "border-outline-variant bg-paper-white hover:border-green-300 hover:bg-green-50/50 cursor-pointer" : "border-green-500 bg-green-50 shadow-md ring-2 ring-green-200")">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg @(IsLive ? "bg-surface-container" : "bg-green-500") flex items-center justify-center">
                            <span class="material-symbols-outlined @(IsLive ? "text-slate-gray" : "text-white")" style="font-variation-settings: 'FILL' 1;">science</span>
                        </div>
                        <h3 class="font-headline-md text-headline-md @(IsLive ? "text-on-surface" : "text-green-700")">Sandbox</h3>
                    </div>
                    @if (!IsLive)
                    {
                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded bg-green-500 text-white font-label-sm text-[10px] uppercase">Active</span>
                    }
                </div>
                <p class="font-body-sm text-body-sm @(IsLive ? "text-slate-gray" : "text-green-600")">
                    Safe testing environment with mock verification responses. Use during development and integration testing.
                </p>
                <div class="mt-4 flex items-center gap-2 text-sm @(IsLive ? "text-slate-gray" : "text-green-600")">
                    <span class="material-symbols-outlined text-[16px]">info</span>
                    <span class="font-label-sm text-label-sm">No real NIMC charges</span>
                </div>
            </button>

            <!-- Live Card -->
            <button @onclick="SwitchToLive"
                    class="text-left p-6 rounded-xl border-2 transition-all duration-200 @(IsLive ? "border-red-500 bg-red-50 shadow-md ring-2 ring-red-200" : "border-outline-variant bg-paper-white hover:border-red-300 hover:bg-red-50/50 cursor-pointer")">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg @(IsLive ? "bg-red-500" : "bg-surface-container") flex items-center justify-center">
                            <span class="material-symbols-outlined @(IsLive ? "text-white" : "text-slate-gray")" style="font-variation-settings: 'FILL' 1;">cell_tower</span>
                        </div>
                        <h3 class="font-headline-md text-headline-md @(IsLive ? "text-red-700" : "text-on-surface")">Live (Production)</h3>
                    </div>
                    @if (IsLive)
                    {
                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded bg-red-500 text-white font-label-sm text-[10px] uppercase">Active</span>
                    }
                </div>
                <p class="font-body-sm text-body-sm @(IsLive ? "text-red-600" : "text-slate-gray")">
                    Production environment connected to real NIMC partner API. Every verification call charges your wallet.
                </p>
                <div class="mt-4 flex items-center gap-2 text-sm @(IsLive ? "text-red-600" : "text-slate-gray")">
                    <span class="material-symbols-outlined text-[16px]">warning</span>
                    <span class="font-label-sm text-label-sm">Real charges apply</span>
                </div>
            </button>
        </div>

        <!-- API Info -->
        <div class="bg-surface-container-low border border-outline-variant rounded-xl p-6">
            <h3 class="font-label-md text-label-md text-on-surface uppercase tracking-wider mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">key</span>
                IDaccess Partner API
            </h3>
            <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4">
                <div class="flex items-center gap-2 mb-2">
                    <span class="w-2 h-2 rounded-full bg-deep-navy"></span>
                    <span class="font-label-sm text-label-sm text-slate-gray uppercase">Fixed Configuration</span>
                </div>
                <code class="font-body-sm text-body-sm text-on-surface block space-y-1">
                    <div><span class="text-slate-gray">Base URL:</span> https://api.idaccess.info/v1</div>
                    <div><span class="text-slate-gray">API Key:</span> Set via IDACCESS_API_KEY env var</div>
                </code>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="flex items-center gap-3 p-4 @(IsLive ? "bg-green-50 border border-green-200 text-green-700" : "bg-green-50 border border-green-200 text-green-700") rounded">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span class="font-body-sm text-body-sm">@_message</span>
            </div>
        }
    }
</div>

@code {
    private string _activeEnv = "sandbox";
    private bool _loading = true;
    private string? _error;
    private string? _message;

    private bool IsLive => _activeEnv == "live";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var result = await Api.GetAsync<NimcEnvironmentDto>("/v1/admin/nimc");
            if (result is not null)
                _activeEnv = result.ActiveEnvironment;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load config: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task SwitchToSandbox() => SwitchToEnv("sandbox");
    private Task SwitchToLive() => SwitchToEnv("live");

    private async Task SwitchToEnv(string env)
    {
        if (env == _activeEnv) return;

        try
        {
            await Api.PutAsync("/v1/admin/nimc", new { environment = env });
            _activeEnv = env;
            _message = $"Switched to {(env == "live" ? "Live (Production)" : "Sandbox (Testing)")} environment.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to switch: {ex.Message}";
        }
    }
}
