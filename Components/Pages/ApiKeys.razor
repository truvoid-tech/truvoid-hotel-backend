@page "/api-keys"
@rendermode InteractiveServer
@layout DashboardLayout
@inject ApiClient Api

<PageTitle>TruvoID — API Keys</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex-1">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
        <div>
            <h2 class="font-display-lg text-display-lg text-deep-navy mb-2">API Keys</h2>
            <p class="font-body-lg text-body-lg text-slate-gray max-w-2xl">Manage programmatic access keys for the TruvoID Gateway API.</p>
        </div>
        <button @onclick="() => _showCreateModal = true"
                class="flex items-center gap-2 bg-warm-gold text-paper-white font-label-md text-label-md uppercase py-3 px-6 rounded hover:opacity-90 transition-opacity">
            <span class="material-symbols-outlined text-[18px]">key</span>
            Generate New Key
        </button>
    </div>

    <!-- Warning Banner -->
    <div class="bg-[#fef7e0] border border-[#fde083] rounded-lg p-4 mb-8 flex items-start gap-3">
        <span class="material-symbols-outlined text-[#b06000] mt-0.5">info</span>
        <div>
            <p class="font-body-sm text-body-sm text-[#b06000] font-medium">API keys provide full access to your institution's verification API.</p>
            <p class="font-body-sm text-[12px] text-[#b06000]/80 mt-1">Keep them secret. Never expose keys in client-side code or public repositories. You can revoke a key at any time.</p>
        </div>
    </div>

    <!-- Keys Table -->
    <div class="bg-paper-white border border-outline-variant rounded-xl overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-outline-variant">
            <h3 class="font-headline-md text-headline-md text-deep-navy">Active Keys</h3>
        </div>

        @if (_loading)
        {
            <div class="flex items-center justify-center py-16">
                <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
            </div>
        }
        else if (_keys is null || !_keys.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 gap-4">
                <span class="material-symbols-outlined text-outline text-[48px]">key_off</span>
                <p class="font-body-md text-body-md text-slate-gray">No API keys generated yet.</p>
                <button @onclick="() => _showCreateModal = true"
                        class="bg-warm-gold text-paper-white font-label-md text-label-md uppercase py-2 px-4 rounded hover:opacity-90 transition-opacity">
                    Generate First Key
                </button>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full min-w-[700px]">
                    <thead class="bg-surface-container-low border-b border-outline-variant">
                        <tr>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Key</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Description</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Status</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Created</th>
                            <th class="text-right px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in _keys)
                        {
                            <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-slate-gray text-[18px]">key</span>
                                        <code class="font-label-md text-label-md text-deep-navy bg-surface-container-low px-2 py-1 rounded">@key.KeyPrefix…</code>
                                    </div>
                                </td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-on-surface">@(key.Description ?? "—")</td>
                                <td class="px-6 py-4">
                                    @if (key.Status == TruvoID.Domain.Enums.ApiKeyStatus.Active)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#e6f4ea] text-[#137333] font-label-sm text-label-sm uppercase">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#137333]"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-surface-variant text-on-surface-variant font-label-sm text-label-sm uppercase">
                                            Revoked
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">@key.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4 text-right">
                                    @if (key.Status == TruvoID.Domain.Enums.ApiKeyStatus.Active)
                                    {
                                        <button @onclick="() => ConfirmRevoke(key)"
                                                class="p-2 rounded hover:bg-error-container/30 transition-colors text-slate-gray hover:text-error"
                                                title="Revoke key">
                                            <span class="material-symbols-outlined text-[18px]">block</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Generate Key Modal -->
@if (_showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" @onclick="() => _showCreateModal = false">
        <div class="absolute inset-0 bg-ink/40"></div>
        <div class="relative bg-paper-white rounded-xl shadow-xl w-full max-w-lg border border-outline-variant p-8" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between mb-6">
                <h3 class="font-headline-md text-headline-md text-deep-navy">Generate API Key</h3>
                <button @onclick="() => _showCreateModal = false" class="text-slate-gray hover:text-deep-navy">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            @if (_createdKeyRaw is not null)
            {
                <!-- Key revealed — show once -->
                <div class="bg-[#fef7e0] border border-[#fde083] rounded-lg p-4 mb-4 flex items-start gap-3">
                    <span class="material-symbols-outlined text-[#b06000] mt-0.5">warning</span>
                    <div>
                        <p class="font-body-sm text-body-sm text-[#b06000] font-medium">Save this key now!</p>
                        <p class="font-body-sm text-[12px] text-[#b06000]/80 mt-1">It will not be shown again after you close this dialog.</p>
                    </div>
                </div>
                <div class="bg-surface-container-low border border-outline-variant rounded-lg p-4 mb-6">
                    <code class="font-label-md text-label-md text-deep-navy break-all select-all">@_createdKeyRaw</code>
                </div>
                <button @onclick="CloseCreateModal"
                        class="w-full bg-deep-navy text-paper-white font-label-md text-label-md uppercase py-3 rounded hover:opacity-90 transition-opacity">
                    Done — I've Saved This Key
                </button>
            }
            else
            {
                <EditForm Model="_createRequest" OnValidSubmit="HandleCreate" class="flex flex-col gap-4">
                    <div>
                        <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Description</label>
                        <input @bind="_createRequest.Description"
                               class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none"
                               placeholder="e.g. Production integration for onboarding flow" />
                        <p class="font-body-sm text-[12px] text-slate-gray mt-1">Optional. Helps you identify which key is used where.</p>
                    </div>

                    <div class="flex gap-3 mt-4">
                        <button type="button" @onclick="() => _showCreateModal = false"
                                class="flex-1 border border-deep-navy text-deep-navy font-label-md text-label-md uppercase py-3 rounded hover:bg-surface-container-low transition-colors">
                            Cancel
                        </button>
                        <button type="submit" disabled="@_creating"
                                class="flex-1 bg-warm-gold text-paper-white font-label-md text-label-md uppercase py-3 rounded hover:opacity-90 transition-opacity disabled:opacity-50 flex items-center justify-center gap-2">
                            @if (_creating)
                            {
                                <div class="w-4 h-4 border-2 border-paper-white border-t-transparent rounded-full animate-spin"></div>
                            }
                            <span>Generate Key</span>
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

<!-- Confirm Revoke Modal -->
@if (_showRevokeModal && _revokingKey is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" @onclick="() => _showRevokeModal = false">
        <div class="absolute inset-0 bg-ink/40"></div>
        <div class="relative bg-paper-white rounded-xl shadow-xl w-full max-w-md border border-outline-variant p-8" @onclick:stopPropagation="true">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-full bg-error-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-error">block</span>
                </div>
                <div>
                    <h3 class="font-headline-md text-headline-md text-deep-navy">Revoke API Key</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray">This action is immediate and cannot be undone.</p>
                </div>
            </div>

            <div class="bg-surface-container-low rounded-lg p-4 mb-6">
                <code class="font-label-md text-label-md text-deep-navy">@_revokingKey.KeyPrefix…</code>
                @if (!string.IsNullOrEmpty(_revokingKey.Description))
                {
                    <p class="font-body-sm text-[12px] text-slate-gray mt-1">@_revokingKey.Description</p>
                }
            </div>

            <p class="font-body-sm text-body-sm text-on-surface mb-6">Any applications using this key will immediately lose access to the TruvoID API.</p>

            <div class="flex gap-3">
                <button @onclick="() => _showRevokeModal = false"
                        class="flex-1 border border-deep-navy text-deep-navy font-label-md text-label-md uppercase py-3 rounded hover:bg-surface-container-low transition-colors">
                    Keep Key
                </button>
                <button @onclick="RevokeKey"
                        class="flex-1 bg-error text-paper-white font-label-md text-label-md uppercase py-3 rounded hover:opacity-90 transition-opacity">
                    Revoke Key
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ApiKeyResponse>? _keys;
    private bool _loading = true;

    // Create modal
    private bool _showCreateModal = false;
    private bool _creating = false;
    private string? _createdKeyRaw;
    private CreateApiKeyRequest _createRequest = new() { Description = string.Empty };

    // Revoke modal
    private bool _showRevokeModal = false;
    private ApiKeyResponse? _revokingKey;

    protected override async Task OnInitializedAsync()
    {
        await LoadKeys();
    }

    private async Task LoadKeys()
    {
        _loading = true;
        try
        {
            _keys = await Api.GetAsync<List<ApiKeyResponse>>("v1/api-keys");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load API keys: {ex.Message}");
            _keys = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleCreate()
    {
        _creating = true;
        try
        {
            var result = await Api.PostAsync<ApiKeyResponse>("v1/api-keys", _createRequest);
            _createdKeyRaw = result.RawKey;
            _createRequest = new() { Description = string.Empty };
            await LoadKeys();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to create key: {ex.Message}");
        }
        finally
        {
            _creating = false;
        }
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
        _createdKeyRaw = null;
    }

    private void ConfirmRevoke(ApiKeyResponse key)
    {
        _revokingKey = key;
        _showRevokeModal = true;
    }

    private async Task RevokeKey()
    {
        if (_revokingKey is null) return;
        try
        {
            await Api.DeleteAsync($"v1/api-keys/{_revokingKey.Id}");
            _showRevokeModal = false;
            _revokingKey = null;
            await LoadKeys();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to revoke key: {ex.Message}");
        }
    }
}
