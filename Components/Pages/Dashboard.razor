@page "/dashboard"
@namespace TruvoID.Components.DashboardPage
@layout DashboardLayout
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Nav

<AuthGuard />
<PageTitle>TruvoID — Dashboard</PageTitle>

@if (_showCreditBanner && _latestCreditNotification is not null)
{
    <div class="mx-margin-mobile md:mx-margin-desktop mb-6 bg-[#e6f4ea] border border-[#ceead6] rounded-lg p-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
            <span class="material-symbols-outlined text-[#137333] text-[24px] shrink-0" style="font-variation-settings: 'FILL' 1;">account_balance_wallet</span>
            <div class="min-w-0">
                <p class="font-label-md text-label-md text-[#137333] font-semibold">Wallet Credited!</p>
                <p class="font-body-sm text-body-sm text-[#137333]">@_latestCreditNotification.Message</p>
            </div>
        </div>
        <button @onclick="DismissCreditBanner" class="p-1 hover:bg-[#ceead6] rounded shrink-0">
            <span class="material-symbols-outlined text-[#137333] text-[18px]">close</span>
        </button>
    </div>
}

@if (_profileLoaded && _profile?.Status == "Pending")
{
    <div class="flex-1 flex items-center justify-center p-8">
        <div class="max-w-md w-full bg-paper-white border border-outline-variant rounded shadow-sm overflow-hidden text-center">
            <div class="h-1 w-full bg-warm-gold"></div>
            <div class="p-8 flex flex-col items-center gap-5">
                <div class="w-16 h-16 rounded-full bg-[#fef7e0] border border-[#fde083] flex items-center justify-center">
                    <span class="material-symbols-outlined text-[#b06000] text-[32px]" style="font-variation-settings: 'FILL' 1;">pending_actions</span>
                </div>
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface mb-2">Awaiting Approval</h2>
                    <p class="font-body-sm text-body-sm text-slate-gray">Your account is under review by the TruvoID team. You'll receive an email once approved.</p>
                </div>
                <a href="/pending-approval" class="flex items-center gap-2 bg-deep-navy text-paper-white font-label-md text-label-md uppercase px-6 py-3 rounded hover:bg-ink transition-colors">
                    View Status
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>
        </div>
    </div>
}
else
{

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex-1 flex flex-col gap-section-gap">

    <!-- Hero: Wallet Balance + Quick Action -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">

        <!-- Wallet Balance Card -->
        <div class="md:col-span-8 bg-paper-white border-t-[3px] border-t-warm-gold border-x border-b border-outline-variant rounded shadow-sm p-5 sm:p-8 flex flex-col justify-between gap-6 sm:gap-8">
            <div class="flex flex-wrap justify-between items-start gap-4">
                <div>
                    <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-2">Available Balance</p>
                    <div class="flex items-end gap-2">
                        <span class="font-display-lg text-display-lg text-primary font-bold leading-none">&#8358;@(_balance?.Balance.ToString("N2") ?? "0.00")</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-slate-gray mt-2">Estimated capacity: <span class="font-semibold text-on-surface">~@(_balance != null ? ((int)(_balance.Balance / 50)).ToString("N0") : "0") verifications</span></p>
                </div>
                <div class="flex flex-col items-end gap-3">
                    <div class="flex items-center gap-2 bg-surface-container-low border border-outline-variant rounded px-3 py-1.5">
                        <span class="w-2 h-2 rounded-full bg-[#34a853] inline-block"></span>
                        <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Operational</span>
                    </div>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 border-t border-outline-variant pt-6">
                <a href="/wallet" class="flex items-center justify-center gap-2 bg-warm-gold hover:opacity-90 transition-opacity text-paper-white font-label-md text-label-md uppercase py-2.5 px-6 rounded">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    Top Up
                </a>
                <a href="/history" class="flex items-center justify-center gap-2 border border-outline text-slate-gray hover:text-on-surface hover:border-on-surface transition-colors font-label-md text-label-md uppercase py-2.5 px-6 rounded">
                    <span class="material-symbols-outlined text-[18px]">history</span>
                    History
                </a>

                @if (_showCreditBanner == false)
                {
                    <a href="/wallet/topup" class="flex items-center justify-center gap-2 bg-[#fef7e0] border border-[#fde083] text-[#b06000] hover:bg-[#fde083] transition-colors font-label-md text-label-md uppercase py-2.5 px-6 rounded">
                        <span class="material-symbols-outlined text-[18px]">send</span>
                        I Have Sent the Money
                    </a>
                }
            </div>
        </div>

        <!-- Quick Verify Card -->
        <div class="md:col-span-4 bg-deep-navy rounded p-5 sm:p-8 flex flex-col justify-between gap-6">
            <div>
                <span class="material-symbols-outlined text-warm-gold mb-4 block" style="font-variation-settings: 'FILL' 1; font-size: 32px;">verified_user</span>
                <h2 class="font-headline-md text-headline-md text-paper-white mb-2">Verify Identity</h2>
                <p class="font-body-sm text-body-sm text-on-primary/70">NIN, BVN, or Phone — instant verification against national databases.</p>
            </div>
            <a href="/dashboard/verify/new" class="flex items-center justify-center gap-2 bg-warm-gold hover:opacity-90 transition-opacity text-paper-white font-label-md text-label-md uppercase py-3 px-6 rounded">
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                New Verification
            </a>
        </div>
    </div>

    <!-- Activity Summary Bento Grid -->
    <div>
        <div class="flex items-center justify-between mb-6">
            <h2 class="font-headline-md text-headline-md text-on-surface">Activity Summary</h2>
            <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Last 30 days</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-gutter mb-gutter">
            <!-- Total Verifications -->
            <div class="bg-paper-white border border-outline-variant rounded p-6 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Total Verifications</span>
                    <span class="material-symbols-outlined text-deep-navy text-[20px]" style="font-variation-settings: 'FILL' 1;">fact_check</span>
                </div>
                <p class="font-display-lg text-display-lg text-primary font-bold">@(_profile?.ApiCallsMtd.ToString("N0") ?? "0")</p>
            </div>

            <!-- Successful -->
            <div class="bg-paper-white border border-outline-variant rounded p-6 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Successful</span>
                    <span class="material-symbols-outlined text-deep-navy text-[20px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                </div>
                <p class="font-display-lg text-display-lg text-primary font-bold">@(_profile?.SuccessfulCallsMtd.ToString("N0") ?? "0")</p>
            </div>

            <!-- Failed -->
            <div class="bg-paper-white border border-outline-variant rounded p-6 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Failed</span>
                    <span class="material-symbols-outlined text-deep-navy text-[20px]" style="font-variation-settings: 'FILL' 1;">report</span>
                </div>
                <p class="font-display-lg text-display-lg text-error font-bold">@(_profile?.FailedCallsMtd.ToString("N0") ?? "0")</p>
            </div>
        </div>

        <!-- Recent Activity Table -->
        <div class="bg-paper-white border border-outline-variant rounded overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-outline-variant">
                <h3 class="font-label-md text-label-md uppercase text-on-surface">Recent Transactions</h3>
                <a href="/history" class="font-label-sm text-label-sm text-deep-navy hover:text-warm-gold transition-colors uppercase tracking-wider">View All</a>
            </div>
            <div class="overflow-x-auto table-scroll">
                <table class="w-full min-w-[600px]">
                    <thead class="bg-surface-container-low border-b border-outline-variant">
                        <tr>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Transaction ID</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Type</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Amount</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Status</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_recentTransactions.Any())
                        {
                            @foreach (var tx in _recentTransactions)
                            {
                                <tr class="border-b border-outline-variant table-row-hover transition-colors">
                                    <td class="px-6 py-4 font-label-md text-label-md text-deep-navy">@(tx.Reference ?? tx.Id[..8])</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center gap-1 bg-surface-container-low border border-outline-variant rounded px-2 py-1 font-label-sm text-label-sm text-on-surface">
                                            @(tx.Type == WalletTransactionType.Credit ? "Top Up" : "Verification")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 font-body-sm text-body-sm @(tx.Type == WalletTransactionType.Credit ? "text-[#137333]" : "text-on-surface")">
                                        @(tx.Type == WalletTransactionType.Credit ? "+" : "-")&#8358;@tx.Amount.ToString("N2")
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center gap-1 @(tx.Type == WalletTransactionType.Credit ? "bg-[#e6f4ea] text-[#137333] border border-[#ceead6]" : "bg-[#fef7e0] text-[#b06000] border border-[#fde083]") rounded px-2 py-1 font-label-sm text-label-sm">
                                            @(tx.Type == WalletTransactionType.Credit ? "Credit" : "Debit")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">@FormatTimeAgo(tx.CreatedAt)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center">
                                    <span class="material-symbols-outlined text-[40px] text-outline-variant mb-3 block">receipt_long</span>
                                    <p class="font-body-md text-body-md text-slate-gray">No recent transactions</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

} @* end else (institution active) *@

@code {
    private InstitutionProfileResponse? _profile;
    private bool _profileLoaded;
    private WalletBalanceResponse? _balance;
    private List<WalletTransactionResponse> _recentTransactions = [];
    private NotificationFeedItem? _latestCreditNotification;
    private bool _showCreditBanner;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Kick off all requests in parallel, but await each independently so a
        // failure in one (e.g. a transient auth/token-refresh race) can't wipe
        // out data that other calls already fetched successfully.
        var profileTask = Api.GetAsync<InstitutionProfileResponse>("/v1/institution/profile");
        var balanceTask = Api.GetAsync<WalletBalanceResponse>("/v1/wallet/balance");
        var transactionsTask = Api.GetAsync<PaginatedResponse<WalletTransactionResponse>>("/v1/wallet/transactions?pageSize=5");
        var notificationsTask = Api.GetAsync<List<NotificationFeedItem>>("/v1/notifications");

        try { _profile = await profileTask; } catch { }
        try { _balance = await balanceTask; } catch { }
        try { _recentTransactions = (await transactionsTask)?.Items ?? []; } catch { }

        try
        {
            var feed = await notificationsTask;
            // Only unread credit notifications trigger the banner — mark it read the
            // moment it's shown so it pops up once, not on every dashboard visit. It
            // stays visible afterward in the notification feed/bell dropdown.
            var creditNotif = feed?.FirstOrDefault(n => n.Category == "credit" && !n.IsRead);
            if (creditNotif is not null)
            {
                _latestCreditNotification = creditNotif;
                _showCreditBanner = true;
                _ = MarkCreditNotificationReadAsync(creditNotif.Id);
            }
        }
        catch { }

        _profileLoaded = true;
        StateHasChanged();
    }

    private async Task MarkCreditNotificationReadAsync(string id)
    {
        try { await Api.PostRawAsync($"/v1/notifications/{id}/read", new { }); }
        catch { }
    }

    private void DismissCreditBanner() => _showCreditBanner = false;

    private string FormatTimeAgo(DateTime date)
    {
        var span = DateTime.UtcNow - date;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return date.ToString("dd MMM yyyy");
    }
}
