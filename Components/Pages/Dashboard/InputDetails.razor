@page "/dashboard/verify/details"
@layout DashboardLayout

<PageTitle>TruvoID — Subject Details</PageTitle>

<div class="flex-1 max-w-3xl mx-auto w-full px-margin-mobile md:px-margin-desktop py-section-gap flex flex-col gap-10">

    <!-- Progress Indicator -->
    <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
            <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Step 3 of 7 — Subject Details</span>
            <span class="font-label-sm text-label-sm text-deep-navy">42%</span>
        </div>
        <div class="w-full h-1.5 bg-surface-container-high rounded-full overflow-hidden">
            <div class="h-full bg-deep-navy rounded-full transition-all duration-500" style="width: 42%;"></div>
        </div>
        <div class="flex gap-1.5">
            @for (int i = 1; i <= 7; i++)
            {
                <div class="flex-1 h-0.5 @(i <= 3 ? "bg-deep-navy" : "bg-surface-container-high") rounded-full transition-all"></div>
            }
        </div>
    </div>

    <!-- Page Header -->
    <div>
        <div class="flex items-center gap-3 mb-2">
            <span class="material-symbols-outlined text-warm-gold" style="font-variation-settings: 'FILL' 1;">person_search</span>
            <p class="font-label-sm text-label-sm text-deep-navy uppercase tracking-wider">NIN Verification</p>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-primary mb-3">Enter Subject Details</h1>
        <p class="font-body-lg text-body-lg text-slate-gray">
            Provide the information required to query the NIMC database. All requests are logged and audited.
        </p>
    </div>

    <!-- Form Card -->
    <div class="bg-paper-white border border-outline-variant rounded shadow-sm p-8 md:p-10 flex flex-col gap-8">

        <!-- NIN Field -->
        <div class="flex flex-col gap-2">
            <label class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider" for="nin-input">
                National Identity Number (NIN) <span class="text-error ml-0.5">*</span>
            </label>
            <div class="relative">
                <input
                    id="nin-input"
                    type="text"
                    inputmode="numeric"
                    maxlength="11"
                    placeholder="e.g. 12345678901"
                    class="w-full px-4 py-3 bg-background border border-outline-variant rounded font-label-md text-label-md text-primary placeholder:text-slate-gray/50 focus:outline-none focus:border-deep-navy focus:ring-1 focus:ring-deep-navy transition-colors pr-12"
                >
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline text-[18px]">badge</span>
            </div>
            <p class="font-body-sm text-body-sm text-slate-gray">Enter the 11-digit NIN assigned by NIMC.</p>
        </div>

        <!-- Subject Name Field -->
        <div class="flex flex-col gap-2">
            <label class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider" for="subject-name">
                Subject Full Name <span class="text-error ml-0.5">*</span>
            </label>
            <input
                id="subject-name"
                type="text"
                placeholder="As on government-issued ID"
                class="w-full px-4 py-3 bg-background border border-outline-variant rounded font-body-md text-body-md text-primary placeholder:text-slate-gray/50 focus:outline-none focus:border-deep-navy focus:ring-1 focus:ring-deep-navy transition-colors"
            >
            <p class="font-body-sm text-body-sm text-slate-gray">Must match the name registered with NIMC exactly.</p>
        </div>

        <!-- Purpose Dropdown -->
        <div class="flex flex-col gap-2">
            <label class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider" for="purpose">
                Verification Purpose <span class="text-error ml-0.5">*</span>
            </label>
            <div class="relative">
                <select
                    id="purpose"
                    class="w-full px-4 py-3 bg-background border border-outline-variant rounded font-body-md text-body-md text-primary focus:outline-none focus:border-deep-navy focus:ring-1 focus:ring-deep-navy transition-colors appearance-none cursor-pointer"
                >
                    <option value="" disabled selected>Select a purpose...</option>
                    <option value="kyc">KYC / Onboarding</option>
                    <option value="loan">Loan Application</option>
                    <option value="employment">Employment Screening</option>
                    <option value="account">Account Opening</option>
                    <option value="compliance">Regulatory Compliance</option>
                    <option value="other">Other</option>
                </select>
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline text-[18px] pointer-events-none">expand_more</span>
            </div>
            <p class="font-body-sm text-body-sm text-slate-gray">Required for audit trail. Choose the most applicable reason.</p>
        </div>

        <!-- Consent Notice -->
        <div class="bg-surface-container-low border border-outline-variant rounded p-4 flex items-start gap-3">
            <span class="material-symbols-outlined text-deep-navy text-[18px] mt-0.5 shrink-0" style="font-variation-settings: 'FILL' 1;">info</span>
            <p class="font-body-sm text-body-sm text-slate-gray leading-relaxed">
                By proceeding, you confirm this request complies with NDPR regulations and the data subject has provided appropriate consent for this verification.
            </p>
        </div>
    </div>

    <!-- Footer Actions -->
    <div class="flex items-center justify-between border-t border-outline-variant pt-8">
        <a href="/dashboard/verify/select" class="flex items-center gap-2 text-slate-gray hover:text-on-surface font-label-md text-label-md uppercase tracking-wider transition-colors">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Back
        </a>
        <a href="/dashboard/verify/processing" class="flex items-center gap-2 bg-deep-navy hover:bg-primary text-paper-white font-label-md text-label-md uppercase py-3 px-8 rounded transition-colors shadow-sm">
            Review &amp; Submit
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
    </div>

    <!-- Security Note -->
    <div class="flex items-center gap-2 text-slate-gray opacity-60">
        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">lock</span>
        <span class="font-label-sm text-label-sm">All data is encrypted in transit and at rest. This request will be logged.</span>
    </div>
</div>
