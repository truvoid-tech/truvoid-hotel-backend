@page "/dashboard/verify/new"
@layout DashboardLayout
@rendermode InteractiveServer
@inject ApiClient Api

<PageTitle>New Verification — TruvoID</PageTitle>

<style>
    .type-card { cursor: pointer; transition: all 0.3s ease; }
    .type-card.selected { border-color: #1f3864; background-color: #f7f9fc; }
    .type-card.selected .top-accent { opacity: 1; }
    .type-card.selected .card-icon { color: #1f3864; font-variation-settings: 'FILL' 1; }
    .input-bespoke:focus { border-color: #1f3864; box-shadow: inset 0 0 0 1px #1f3864; outline: none; }
    .step-fade-in { animation: fadeSlideIn 0.4s ease-out; }
    @@keyframes fadeSlideIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    .spinner { border: 4px solid #e6e8eb; border-radius: 50%; border-top: 4px solid #B8860B; width: 48px; height: 48px; animation: spin 1s linear infinite; }
    @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    .progress-fill { transition: width 0.5s ease-out; }
</style>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex-1">

    @if (Step == 1)
    {
        <!-- ═══════════ STEP 1: Select Verification Type ═══════════ -->
        <div class="step-fade-in">
            <div class="text-center md:text-left mb-16 md:w-2/3">
                <h1 class="font-display-lg text-display-lg text-deep-navy mb-4">Select Verification Type</h1>
                <p class="font-body-lg text-body-lg text-slate-gray">Choose the designated authority database to query for this subject. Costs per successful match will be automatically deducted from your institutional balance.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
                <!-- NIN -->
                <div class="type-card relative bg-surface-container-lowest border border-outline-variant rounded p-6 @(SelectedType == "nin" ? "selected" : "")" @onclick='() => SelectType("nin")'>
                    <div class="top-accent absolute top-0 left-0 right-0 h-[2px] bg-warm-gold opacity-0 transition-opacity duration-300 rounded-t"></div>
                    <div class="flex justify-between items-start mb-8">
                        <span class="material-symbols-outlined card-icon text-[32px] text-slate-gray transition-colors duration-300">badge</span>
                        <div class="bg-surface-container px-3 py-1.5 rounded flex items-center gap-2">
                            <span class="font-label-md text-label-md text-deep-navy">₦100.00</span>
                            <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">/ Hit</span>
                        </div>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-deep-navy mb-3">National Identity Number</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray mb-6">Comprehensive demographic and biometric verification directly via NIMC database. Highest assurance level.</p>
                    <div class="flex items-center gap-2 font-label-sm text-label-sm text-outline mt-auto">
                        <span class="material-symbols-outlined text-[16px]">verified_user</span>
                        <span>Tier 1 KYC Compliant</span>
                    </div>
                </div>

                <!-- BVN -->
                <div class="type-card relative bg-surface-container-lowest border border-outline-variant rounded p-6 @(SelectedType == "bvn" ? "selected" : "")" @onclick='() => SelectType("bvn")'>
                    <div class="top-accent absolute top-0 left-0 right-0 h-[2px] bg-warm-gold opacity-0 transition-opacity duration-300 rounded-t"></div>
                    <div class="flex justify-between items-start mb-8">
                        <span class="material-symbols-outlined card-icon text-[32px] text-slate-gray transition-colors duration-300">account_balance</span>
                        <div class="bg-surface-container px-3 py-1.5 rounded flex items-center gap-2">
                            <span class="font-label-md text-label-md text-deep-navy">₦150.00</span>
                            <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">/ Hit</span>
                        </div>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-deep-navy mb-3">Bank Verification Number</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray mb-6">Financial identity matching across unified inter-bank systems. Ideal for credit assessments.</p>
                    <div class="flex items-center gap-2 font-label-sm text-label-sm text-outline mt-auto">
                        <span class="material-symbols-outlined text-[16px]">assured_workload</span>
                        <span>CBN Authorized API</span>
                    </div>
                </div>

                <!-- Phone -->
                <div class="type-card relative bg-surface-container-lowest border border-outline-variant rounded p-6 @(SelectedType == "phone" ? "selected" : "")" @onclick='() => SelectType("phone")'>
                    <div class="top-accent absolute top-0 left-0 right-0 h-[2px] bg-warm-gold opacity-0 transition-opacity duration-300 rounded-t"></div>
                    <div class="flex justify-between items-start mb-8">
                        <span class="material-symbols-outlined card-icon text-[32px] text-slate-gray transition-colors duration-300">phone_iphone</span>
                        <div class="bg-surface-container px-3 py-1.5 rounded flex items-center gap-2">
                            <span class="font-label-md text-label-md text-deep-navy">₦50.00</span>
                            <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">/ Hit</span>
                        </div>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-deep-navy mb-3">Phone Number (Telco)</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray mb-6">Rapid subscriber matching via telecommunication provider registries. Suitable for basic screening.</p>
                    <div class="flex items-center gap-2 font-label-sm text-label-sm text-outline mt-auto">
                        <span class="material-symbols-outlined text-[16px]">speed</span>
                        <span>Low Latency Query</span>
                    </div>
                </div>
            </div>

            <div class="mt-16 pt-8 border-t border-outline-variant flex justify-between items-center">
                <span class="font-label-sm text-label-sm text-slate-gray">@(string.IsNullOrEmpty(SelectedType) ? "No selection made." : $"Selected: {SelectedType.ToUpper()}")</span>
                <button class="@(string.IsNullOrEmpty(SelectedType) ? "bg-surface-variant text-outline cursor-not-allowed" : "bg-deep-navy text-on-primary hover:bg-primary-container shadow-sm") px-8 py-3 rounded font-label-md text-label-md uppercase tracking-wider transition-all duration-300"
                        disabled="@(string.IsNullOrEmpty(SelectedType))" @onclick="GoToStep2">
                    Continue to Input
                </button>
            </div>
        </div>
    }
    else if (Step == 2)
    {
        <!-- ═══════════ STEP 2: Input Details ═══════════ -->
        <div class="step-fade-in max-w-3xl mx-auto">
            <div class="mb-8">
                <div class="flex justify-between text-label-sm font-label-sm text-outline mb-2">
                    <span>STEP 2 OF 2</span>
                    <span>SUBJECT DETAILS</span>
                </div>
                <div class="w-full bg-surface-container-high h-1 rounded-full overflow-hidden">
                    <div class="bg-deep-navy h-full progress-fill" style="width: 100%;"></div>
                </div>
            </div>

            <h1 class="font-headline-lg text-headline-lg text-deep-navy mb-2">Subject Details</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mb-8">Please provide the necessary identification details for the subject. Ensure accuracy to maintain compliance.</p>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 md:p-8 shadow-sm border-t-2 border-t-warm-gold relative">
                <div class="absolute top-4 right-4 flex items-center gap-1.5 bg-surface-container text-deep-navy px-2 py-1 rounded font-label-sm text-label-sm">
                    <span class="material-symbols-outlined text-[14px]">lock</span>
                    <span>ENCRYPTED</span>
                </div>

                <div class="flex flex-col gap-6 mt-4">
                    <div class="bg-surface-container-low p-4 rounded border border-outline-variant/50">
                        <span class="block font-label-sm text-label-sm text-outline mb-1 uppercase">Selected Verification Type</span>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">@(SelectedType == "nin" ? "badge" : SelectedType == "bvn" ? "account_balance" : "phone_iphone")</span>
                            <span class="font-body-md text-body-md text-deep-navy font-semibold">@(SelectedType == "nin" ? "National Identity Number (NIN)" : SelectedType == "bvn" ? "Bank Verification Number (BVN)" : "Phone Number")</span>
                        </div>
                    </div>

                    <div>
                        <label class="block font-label-sm text-label-sm text-deep-navy mb-2 uppercase">@(SelectedType == "nin" ? "11-Digit NIN Input" : SelectedType == "bvn" ? "11-Digit BVN Input" : "Phone Number")</label>
                        <div class="relative">
                            <input class="w-full bg-transparent border border-outline-variant rounded px-4 py-3 font-label-md text-label-md text-on-surface input-bespoke placeholder:text-outline-variant"
                                   @bind="_subjectRef"
                                   placeholder="@(SelectedType == "phone" ? "e.g. 08012345678" : "e.g. 12345678901")"
                                   maxlength="@(SelectedType == "phone" ? "11" : "11")" />
                            <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-outline">
                                <span class="material-symbols-outlined">dialpad</span>
                            </div>
                        </div>
                        <p class="mt-1.5 font-label-sm text-label-sm text-outline-variant">Enter the exact digits without spaces or hyphens.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="p-4 bg-error-container/30 border border-error/20 rounded-lg flex items-start gap-3">
                            <span class="material-symbols-outlined text-error mt-0.5">error</span>
                            <div>
                                <p class="font-semibold text-on-error-container text-body-md">@(_errorMessage.Contains("Insufficient") ? "Insufficient Balance" : "Error")</p>
                                <p class="text-on-surface-variant text-body-sm mt-1">@_errorMessage</p>
                            </div>
                        </div>
                    }

                    <div class="flex flex-col-reverse sm:flex-row justify-between items-center gap-4 mt-4 pt-6 border-t border-outline-variant/30">
                        <button class="w-full sm:w-auto px-6 py-3 border-[1.5px] border-deep-navy text-deep-navy font-label-md text-label-md uppercase rounded hover:bg-surface-container-low transition-colors" @onclick="() => Step = 1">
                            Back
                        </button>
                        <button class="w-full sm:w-auto px-8 py-3 bg-deep-navy text-on-primary font-label-md text-label-md uppercase rounded flex justify-center items-center gap-2 hover:bg-opacity-90 transition-opacity shadow-sm disabled:opacity-50"
                                disabled="@(string.IsNullOrWhiteSpace(_subjectRef) || _isLoading)" @onclick="RunVerification">
                            @if (_isLoading)
                            {
                                <span>Processing...</span>
                            }
                            else
                            {
                                <span>Submit Verification</span>
                                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Step == 3)
    {
        <!-- ═══════════ STEP 3: Processing ═══════════ -->
        <div class="step-fade-in max-w-2xl mx-auto text-center py-16">
            <div class="spinner mx-auto mb-8"></div>
            <h2 class="font-headline-md text-headline-md text-deep-navy mb-2">Connecting to Verification Registry</h2>
            <p class="font-body-sm text-body-sm text-slate-gray mb-8">Establishing secure connection... <span class="font-label-md text-on-surface ml-1">@_elapsedTime</span> elapsed</p>
            <div class="w-full max-w-sm mx-auto bg-surface-container-high h-1 mb-8 rounded-full overflow-hidden relative">
                <div class="absolute top-0 left-0 h-full bg-warm-gold progress-fill" style="width: @(_progress)%"></div>
            </div>
            <div class="flex items-start gap-3 bg-surface p-4 border border-outline-variant rounded text-left max-w-md mx-auto">
                <span class="material-symbols-outlined text-outline text-[20px] mt-0.5">info</span>
                <p class="font-label-sm text-label-sm text-outline uppercase tracking-wider leading-relaxed">Establishing secure connection to core registry. Real-time latency expected. Please do not close this window.</p>
            </div>
        </div>
    }
    else if (Step == 4 && _result is not null)
    {
        <!-- ═══════════ STEP 4: Result ═══════════ -->
        <div class="step-fade-in max-w-3xl mx-auto">

            @if (_result.Status == "match" && _result.Data is not null)
            {
                <!-- Match Result -->
                <div class="flex flex-col items-center text-center gap-6 mb-10">
                    <div class="w-24 h-24 rounded-full bg-primary-fixed text-deep-navy flex items-center justify-center shadow-sm">
                        <span class="material-symbols-outlined text-[48px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                    </div>
                    <div>
                        <h1 class="font-display-lg text-display-lg text-deep-navy mb-2">Identity Verified</h1>
                        <p class="font-body-lg text-body-lg text-slate-gray">The provided identity has been successfully matched against the registry.</p>
                    </div>
                </div>

                <div class="bg-surface rounded-lg border-t-2 border-t-warm-gold border-x border-b border-outline-variant shadow-[0_12px_32px_-4px_rgba(31,56,100,0.05)] overflow-hidden flex flex-col md:flex-row">
                    <div class="p-8 bg-surface-container flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-outline-variant w-full md:w-1/3">
                        <div class="w-32 h-32 rounded bg-surface-container-high border border-outline-variant overflow-hidden mb-4 flex items-center justify-center">
                            @if (!string.IsNullOrEmpty(_result.Data.PhotoUrl))
                            {
                                <img src="@_result.Data.PhotoUrl" alt="Photo" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-[48px] text-outline">person</span>
                            }
                        </div>
                        <div class="flex items-center gap-2 text-deep-navy font-label-sm text-label-sm uppercase">
                            <span class="w-2 h-2 rounded-full bg-green-600"></span>
                            Match Confirmed
                        </div>
                    </div>
                    <div class="p-8 flex-1 flex flex-col gap-6">
                        <div class="flex justify-between items-start border-b border-outline-variant pb-4">
                            <div class="flex flex-col gap-1">
                                <span class="font-label-sm text-label-sm text-outline uppercase">Full Legal Name</span>
                                <span class="font-headline-md text-headline-md text-deep-navy">@(_result.Data.Name ?? "N/A")</span>
                            </div>
                        </div>
                        <div class="flex justify-between items-start border-b border-outline-variant pb-4">
                            <div class="flex flex-col gap-1">
                                <span class="font-label-sm text-label-sm text-outline uppercase">Gender</span>
                                <span class="font-body-lg text-body-lg text-ink">@(_result.Data.Gender ?? "N/A")</span>
                            </div>
                        </div>
                        <div class="flex justify-between items-start border-b border-outline-variant pb-4">
                            <div class="flex flex-col gap-1">
                                <span class="font-label-sm text-label-sm text-outline uppercase">Phone Number</span>
                                <span class="font-body-lg text-body-lg text-ink">@(_result.Data.PhoneNumber ?? "N/A")</span>
                            </div>
                        </div>
                        <div class="flex justify-between items-start">
                            <div class="flex flex-col gap-1">
                                <span class="font-label-sm text-label-sm text-outline uppercase">Date of Birth</span>
                                <span class="font-body-lg text-body-lg text-ink">@(_result.Data.DateOfBirth ?? "N/A")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_result.Status == "error")
            {
                <!-- Error Result -->
                <div class="flex flex-col items-center text-center gap-6 mb-10">
                    <div class="w-24 h-24 rounded-full bg-secondary-container text-secondary flex items-center justify-center shadow-sm">
                        <span class="material-symbols-outlined text-[48px]" style="font-variation-settings: 'FILL' 1;">warning</span>
                    </div>
                    <div>
                        <h1 class="font-display-lg text-display-lg text-deep-navy mb-2">@(_result.ErrorCode == "INSUFFICIENT_BALANCE" ? "Insufficient Balance" : "Verification Error")</h1>
                        <p class="font-body-lg text-body-lg text-slate-gray">@(_result.ErrorMessage ?? "An error occurred during verification.")</p>
                    </div>
                </div>
            }
            else
            {
                <!-- No Match -->
                <div class="flex flex-col items-center text-center gap-6 mb-10">
                    <div class="w-24 h-24 rounded-full bg-surface-container-highest text-slate-gray flex items-center justify-center shadow-sm">
                        <span class="material-symbols-outlined text-[48px]">person_search</span>
                    </div>
                    <div>
                        <h1 class="font-display-lg text-display-lg text-deep-navy mb-2">No Match Found</h1>
                        <p class="font-body-lg text-body-lg text-slate-gray">The provided identity attributes could not be verified against available registry records at this time.</p>
                    </div>
                </div>
            }

            <div class="flex items-start gap-3 bg-surface-container-highest/50 p-4 rounded border border-outline-variant/50 mx-auto max-w-2xl mb-8">
                <span class="material-symbols-outlined text-outline mt-0.5">lock</span>
                <p class="font-body-sm text-body-sm text-slate-gray">
                    <strong>Data Privacy Protocol Active:</strong> This sensitive data is strictly for immediate verification purposes and is not persisted on TruvoID servers. The session will automatically clear upon navigating away.
                </p>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <button class="w-full sm:w-auto bg-deep-navy text-on-primary font-label-md text-label-md uppercase px-8 py-4 rounded hover:bg-primary transition-colors" @onclick="Reset">
                    Start New Verification
                </button>
                <a href="/dashboard" class="w-full sm:w-auto bg-transparent text-deep-navy border-[1.5px] border-deep-navy font-label-md text-label-md uppercase px-8 py-4 rounded hover:bg-surface-container transition-colors text-center">
                    Back to Dashboard
                </a>
            </div>
        </div>
    }
</div>

@code {
    private int Step = 1;
    private string SelectedType = string.Empty;
    private string _subjectRef = string.Empty;
    private bool _isLoading;
    private string? _errorMessage;
    private VerificationResponse? _result;

    // Processing animation
    private int _progress;
    private string _elapsedTime = "0:00";
    private System.Timers.Timer? _timer;
    private int _elapsedSeconds;

    private void SelectType(string type) => SelectedType = type;

    private void GoToStep2()
    {
        if (!string.IsNullOrEmpty(SelectedType))
            Step = 2;
    }

    private async Task RunVerification()
    {
        if (string.IsNullOrWhiteSpace(_subjectRef)) return;

        Step = 3;
        _isLoading = true;
        _errorMessage = null;
        _progress = 0;
        _elapsedSeconds = 0;
        _elapsedTime = "0:00";

        // Start timer
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (s, e) =>
        {
            _elapsedSeconds++;
            var mins = _elapsedSeconds / 60;
            var secs = _elapsedSeconds % 60;
            _elapsedTime = $"{mins}:{secs:D2}";
            StateHasChanged();
        };
        _timer.Start();

        // Simulate progress
        while (_progress < 90 && _isLoading)
        {
            _progress += Random.Shared.Next(5, 15);
            if (_progress > 90) _progress = 90;
            StateHasChanged();
            await Task.Delay(400);
        }

        try
        {
            if (SelectedType == "nin")
                _result = await Api.PostAsync<VerificationResponse>("/v1/verify/nin", new { nin = _subjectRef.Trim() });
            else if (SelectedType == "bvn")
                _result = await Api.PostAsync<VerificationResponse>("/v1/verify/bvn", new { bvn = _subjectRef.Trim() });
            else
                _result = await Api.PostAsync<VerificationResponse>("/v1/verify/phone", new { phoneNumber = _subjectRef.Trim() });

            _progress = 100;
        }
        catch
        {
            _result = new VerificationResponse
            {
                Status = "error",
                ErrorCode = "UPSTREAM_ERROR",
                ErrorMessage = "Unable to connect to verification service."
            };
        }
        finally
        {
            _timer?.Stop();
            _timer?.Dispose();
            _isLoading = false;
            await Task.Delay(500); // Brief pause at 100%
            Step = 4;
            StateHasChanged();
        }
    }

    private void Reset()
    {
        Step = 1;
        SelectedType = string.Empty;
        _subjectRef = string.Empty;
        _result = null;
        _errorMessage = null;
    }
}
