@page "/dashboard/verify/processing"
@layout OnboardingLayout

<PageTitle>TruvoID — Processing Verification</PageTitle>

<style>
    .state-review { display: flex; }
    .state-processing { display: none; }

    .scanline-container {
        position: relative;
        overflow: hidden;
    }
    .scanline {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #B8860B, transparent);
        opacity: 0.8;
        animation: scanline 1.8s ease-in-out infinite;
    }
    @@keyframes scanline {
        0% { top: 0%; opacity: 0; }
        10% { opacity: 0.8; }
        90% { opacity: 0.8; }
        100% { top: 100%; opacity: 0; }
    }

    .progress-fill {
        width: 0%;
        transition: width 0.4s ease-out;
    }
    .progress-fill.filling {
        animation: progressFill 2.4s ease-out forwards;
    }
    @@keyframes progressFill {
        0% { width: 0%; }
        40% { width: 35%; }
        70% { width: 68%; }
        90% { width: 88%; }
        100% { width: 100%; }
    }

    .check-items > div {
        opacity: 0;
        transform: translateY(4px);
        transition: all 0.3s ease;
    }
    .check-items > div.revealed {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<div class="min-h-screen flex flex-col bg-background text-on-surface antialiased">

    <!-- Wizard Header -->
    <header class="w-full h-16 bg-paper-white border-b border-outline-variant flex items-center justify-between px-margin-mobile md:px-margin-desktop shrink-0">
        <a href="/dashboard/verify/details" class="flex items-center gap-2 text-slate-gray hover:text-deep-navy transition-colors font-label-md text-label-md uppercase tracking-wider">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Back
        </a>
        <div class="flex flex-col items-center">
            <span class="font-headline-md text-headline-md font-bold text-deep-navy">TruvoID</span>
            <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Step 4 of 7</span>
        </div>
        <a href="/dashboard" class="text-slate-gray hover:text-deep-navy transition-colors">
            <span class="material-symbols-outlined">close</span>
        </a>
    </header>

    <!-- Progress Bar -->
    <div class="w-full h-1 bg-surface-container-high">
        <div class="h-full bg-deep-navy transition-all duration-500" style="width: 57%;"></div>
    </div>

    <main class="flex-1 flex items-center justify-center px-margin-mobile md:px-margin-desktop py-section-gap">
        <div class="w-full max-w-xl">

            <!-- STATE 1: Review & Submit -->
            <div class="state-review flex-col gap-8" id="stateReview">

                <div class="text-center mb-4">
                    <p class="font-label-sm text-label-sm text-deep-navy uppercase tracking-wider mb-3">Review &amp; Submit</p>
                    <h1 class="font-headline-lg text-headline-lg text-primary mb-3">Confirm Request Details</h1>
                    <p class="font-body-md text-body-md text-slate-gray">Review before submitting. This request will consume ₦50 from your balance.</p>
                </div>

                <!-- Summary Card -->
                <div class="bg-paper-white border border-outline-variant rounded shadow-sm overflow-hidden scanline-container" id="reviewCard">
                    <div class="bg-deep-navy px-6 py-4 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-warm-gold text-[18px]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                            <span class="font-label-md text-label-md text-paper-white uppercase tracking-wider">Verification Request</span>
                        </div>
                        <span class="font-label-sm text-label-sm text-on-primary/70 uppercase">Draft</span>
                    </div>

                    <div class="p-6 flex flex-col gap-6">
                        <div class="grid grid-cols-2 gap-6">
                            <div>
                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Document Type</p>
                                <p class="font-body-md text-body-md text-on-surface font-semibold">NIN</p>
                            </div>
                            <div>
                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Authority</p>
                                <p class="font-body-md text-body-md text-on-surface font-semibold">NIMC</p>
                            </div>
                            <div>
                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Subject</p>
                                <p class="font-body-md text-body-md text-on-surface font-semibold">··· ···· 1234</p>
                            </div>
                            <div>
                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Purpose</p>
                                <p class="font-body-md text-body-md text-on-surface font-semibold">KYC / Onboarding</p>
                            </div>
                        </div>
                        <div class="border-t border-outline-variant pt-4 flex items-center justify-between">
                            <span class="font-label-sm text-label-sm text-slate-gray uppercase">Deduction</span>
                            <span class="font-label-md text-label-md text-primary font-semibold">₦50.00</span>
                        </div>
                    </div>
                </div>

                <!-- Balance Check -->
                <div class="flex items-center gap-3 bg-surface-container-low border border-outline-variant rounded p-4">
                    <span class="material-symbols-outlined text-[#34a853] text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                    <div>
                        <p class="font-body-sm text-body-sm text-on-surface font-semibold">Sufficient balance</p>
                        <p class="font-body-sm text-[11px] text-slate-gray">₦84,500 available · ₦84,450 after deduction</p>
                    </div>
                </div>

                <!-- Submit Button -->
                <button
                    id="submitBtn"
                    type="button"
                    class="w-full flex items-center justify-center gap-3 bg-deep-navy hover:bg-primary text-paper-white font-label-md text-label-md uppercase py-4 rounded transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">send</span>
                    <span>Submit Verification</span>
                </button>
            </div>

            <!-- STATE 2: Processing -->
            <div class="state-processing flex-col items-center gap-8 text-center" id="stateProcessing">
                <div class="w-20 h-20 rounded-full border-4 border-deep-navy/10 flex items-center justify-center bg-paper-white shadow-sm relative scanline-container mx-auto" style="width: 80px; height: 80px; border-radius: 50%;">
                    <div class="scanline" style="border-radius: 50%;"></div>
                    <span class="material-symbols-outlined text-deep-navy text-[40px]" style="font-variation-settings: 'FILL' 1;">fingerprint</span>
                </div>

                <div>
                    <p class="font-label-sm text-label-sm text-deep-navy uppercase tracking-wider mb-3">Querying NIMC Database</p>
                    <h1 class="font-headline-lg text-headline-lg text-primary mb-3">Processing...</h1>
                    <p class="font-body-md text-body-md text-slate-gray">Securely transmitting request. Do not close this tab.</p>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-surface-container-high rounded-full h-2 overflow-hidden">
                    <div class="progress-fill h-full bg-deep-navy rounded-full" id="progressFill"></div>
                </div>

                <!-- Live Check List -->
                <div class="check-items w-full text-left flex flex-col gap-2" id="checkList">
                    <div class="flex items-center gap-3 bg-paper-white border border-outline-variant rounded px-4 py-3">
                        <span class="material-symbols-outlined text-[#34a853] text-[18px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                        <span class="font-body-sm text-body-sm text-on-surface">Request authenticated</span>
                    </div>
                    <div class="flex items-center gap-3 bg-paper-white border border-outline-variant rounded px-4 py-3">
                        <span class="material-symbols-outlined text-[#34a853] text-[18px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                        <span class="font-body-sm text-body-sm text-on-surface">Encrypted tunnel established</span>
                    </div>
                    <div class="flex items-center gap-3 bg-paper-white border border-outline-variant rounded px-4 py-3">
                        <span class="material-symbols-outlined text-deep-navy text-[18px]" style="font-variation-settings: 'FILL' 1;">sync</span>
                        <span class="font-body-sm text-body-sm text-on-surface">Querying NIMC database...</span>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
    const submitBtn = document.getElementById('submitBtn');
    const stateReview = document.getElementById('stateReview');
    const stateProcessing = document.getElementById('stateProcessing');
    const progressFill = document.getElementById('progressFill');
    const checkItems = document.querySelectorAll('#checkList > div');

    submitBtn.addEventListener('click', () => {
        stateReview.style.display = 'none';
        stateProcessing.style.display = 'flex';
        progressFill.classList.add('filling');

        checkItems.forEach((item, index) => {
            setTimeout(() => {
                item.classList.add('revealed');
            }, 300 + index * 500);
        });

        setTimeout(() => {
            window.location.href = '/dashboard/verify/result';
        }, 2800);
    });
</script>
