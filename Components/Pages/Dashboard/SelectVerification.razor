@page "/dashboard/verify/select"
@layout OnboardingLayout

<PageTitle>TruvoID — Select Verification Type</PageTitle>

<style>
    .verify-card {
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1.5px solid #c4c6d0;
        position: relative;
    }
    .verify-card:hover {
        border-color: #1f3864;
        box-shadow: 0 4px 16px -4px rgba(31, 56, 100, 0.12);
        transform: translateY(-1px);
    }
    .verify-card.selected {
        border-color: #1f3864;
        background-color: #f2f4ff;
        box-shadow: inset 0 0 0 1px #1f3864, 0 4px 16px -4px rgba(31, 56, 100, 0.15);
    }
    .verify-card .check-badge {
        display: none;
    }
    .verify-card.selected .check-badge {
        display: flex;
    }
</style>

<div class="min-h-screen flex flex-col bg-background text-on-surface antialiased">

    <!-- Wizard Header -->
    <header class="w-full h-16 bg-paper-white border-b border-outline-variant flex items-center justify-between px-margin-mobile md:px-margin-desktop shrink-0">
        <a href="/dashboard" class="flex items-center gap-2 text-slate-gray hover:text-deep-navy transition-colors font-label-md text-label-md uppercase tracking-wider">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Cancel
        </a>
        <div class="flex flex-col items-center">
            <span class="font-headline-md text-headline-md font-bold text-deep-navy">TruvoID</span>
            <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Step 2 of 7</span>
        </div>
        <a href="/dashboard" class="text-slate-gray hover:text-deep-navy transition-colors">
            <span class="material-symbols-outlined">close</span>
        </a>
    </header>

    <!-- Progress Bar -->
    <div class="w-full h-1 bg-surface-container-high">
        <div class="h-full bg-deep-navy transition-all duration-500" style="width: 28%;"></div>
    </div>

    <main class="flex-1 flex flex-col items-center justify-center px-margin-mobile md:px-margin-desktop py-section-gap">
        <div class="w-full max-w-3xl">

            <div class="text-center mb-12">
                <p class="font-label-sm text-label-sm text-deep-navy uppercase tracking-wider mb-3">Select Verification Type</p>
                <h1 class="font-headline-lg text-headline-lg md:font-display-lg md:text-display-lg text-primary mb-4">What are you verifying?</h1>
                <p class="font-body-lg text-body-lg text-slate-gray max-w-xl mx-auto">
                    Choose the identity document type to validate against the appropriate national database.
                </p>
            </div>

            <!-- Verification Type Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-12" id="verifyCards">

                <!-- NIN Card -->
                <div class="verify-card bg-paper-white rounded p-6 flex flex-col gap-4" data-type="NIN" id="card-NIN">
                    <div class="check-badge absolute top-4 right-4 w-5 h-5 rounded-full bg-deep-navy items-center justify-center">
                        <span class="material-symbols-outlined text-paper-white text-[12px]" style="font-variation-settings: 'FILL' 1;">check</span>
                    </div>
                    <div class="w-12 h-12 rounded bg-surface-container-low border border-outline-variant flex items-center justify-center">
                        <span class="material-symbols-outlined text-deep-navy" style="font-variation-settings: 'FILL' 1;">badge</span>
                    </div>
                    <div>
                        <h3 class="font-headline-md text-headline-md text-primary mb-1">NIN</h3>
                        <p class="font-body-sm text-body-sm text-slate-gray leading-relaxed">National Identity Number via NIMC database</p>
                    </div>
                    <div class="mt-auto flex items-center justify-between border-t border-outline-variant pt-4">
                        <span class="font-label-sm text-label-sm text-slate-gray uppercase">Per check</span>
                        <span class="font-label-md text-label-md text-primary font-semibold">₦50.00</span>
                    </div>
                </div>

                <!-- BVN Card -->
                <div class="verify-card bg-paper-white rounded p-6 flex flex-col gap-4" data-type="BVN" id="card-BVN">
                    <div class="check-badge absolute top-4 right-4 w-5 h-5 rounded-full bg-deep-navy items-center justify-center">
                        <span class="material-symbols-outlined text-paper-white text-[12px]" style="font-variation-settings: 'FILL' 1;">check</span>
                    </div>
                    <div class="w-12 h-12 rounded bg-surface-container-low border border-outline-variant flex items-center justify-center">
                        <span class="material-symbols-outlined text-deep-navy" style="font-variation-settings: 'FILL' 1;">account_balance</span>
                    </div>
                    <div>
                        <h3 class="font-headline-md text-headline-md text-primary mb-1">BVN</h3>
                        <p class="font-body-sm text-body-sm text-slate-gray leading-relaxed">Bank Verification Number via CBN database</p>
                    </div>
                    <div class="mt-auto flex items-center justify-between border-t border-outline-variant pt-4">
                        <span class="font-label-sm text-label-sm text-slate-gray uppercase">Per check</span>
                        <span class="font-label-md text-label-md text-primary font-semibold">₦45.00</span>
                    </div>
                </div>

                <!-- Phone Card -->
                <div class="verify-card bg-paper-white rounded p-6 flex flex-col gap-4" data-type="Phone" id="card-Phone">
                    <div class="check-badge absolute top-4 right-4 w-5 h-5 rounded-full bg-deep-navy items-center justify-center">
                        <span class="material-symbols-outlined text-paper-white text-[12px]" style="font-variation-settings: 'FILL' 1;">check</span>
                    </div>
                    <div class="w-12 h-12 rounded bg-surface-container-low border border-outline-variant flex items-center justify-center">
                        <span class="material-symbols-outlined text-deep-navy" style="font-variation-settings: 'FILL' 1;">phone_iphone</span>
                    </div>
                    <div>
                        <h3 class="font-headline-md text-headline-md text-primary mb-1">Phone</h3>
                        <p class="font-body-sm text-body-sm text-slate-gray leading-relaxed">Mobile number linked to national identity records</p>
                    </div>
                    <div class="mt-auto flex items-center justify-between border-t border-outline-variant pt-4">
                        <span class="font-label-sm text-label-sm text-slate-gray uppercase">Per check</span>
                        <span class="font-label-md text-label-md text-primary font-semibold">₦40.00</span>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="flex items-center justify-between border-t border-outline-variant pt-8">
                <div class="font-body-sm text-body-sm text-slate-gray" id="selectionLabel">No type selected</div>
                <div class="flex gap-4">
                    <a href="/dashboard" class="font-label-md text-label-md text-slate-gray hover:text-on-surface uppercase tracking-wider py-3 px-6 border border-outline-variant rounded transition-colors">
                        Back
                    </a>
                    <a href="/dashboard/verify/details" class="flex items-center gap-2 bg-deep-navy hover:bg-primary text-paper-white font-label-md text-label-md uppercase py-3 px-8 rounded transition-colors shadow-sm opacity-40 pointer-events-none" id="continueBtn">
                        Continue
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    const cards = document.querySelectorAll('.verify-card');
    const continueBtn = document.getElementById('continueBtn');
    const selectionLabel = document.getElementById('selectionLabel');
    let selected = null;

    cards.forEach(card => {
        card.addEventListener('click', () => {
            cards.forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');
            selected = card.dataset.type;
            selectionLabel.textContent = selected + ' selected';
            continueBtn.classList.remove('opacity-40', 'pointer-events-none');
        });
    });
</script>
