@page "/dashboard/verify/result"
@layout OnboardingLayout

<PageTitle>TruvoID — Verification Result</PageTitle>

<div class="min-h-screen flex flex-col bg-background text-on-surface antialiased">

    <!-- Minimal Header -->
    <header class="w-full h-16 bg-paper-white border-b border-outline-variant flex items-center justify-center px-margin-mobile md:px-margin-desktop shrink-0">
        <span class="font-headline-md text-headline-md font-bold text-deep-navy">TruvoID</span>
    </header>

    <main class="flex-1 flex flex-col items-center justify-center px-margin-mobile md:px-margin-desktop py-section-gap">
        <div class="w-full max-w-2xl flex flex-col gap-8">

            <!-- Status Banner -->
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="w-16 h-16 rounded-full bg-[#e6f4ea] border-4 border-[#ceead6] flex items-center justify-center">
                    <span class="material-symbols-outlined text-[#137333] text-[32px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-[#137333] uppercase tracking-wider mb-2">Verification Complete</p>
                    <h1 class="font-headline-lg text-headline-lg md:font-display-lg md:text-display-lg text-primary">Identity Verified</h1>
                </div>
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-2 bg-[#e6f4ea] text-[#137333] border border-[#ceead6] rounded px-3 py-1.5 font-label-md text-label-md">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                        MATCH CONFIRMED
                    </span>
                    <span class="font-body-sm text-body-sm text-slate-gray">TRV-2082942</span>
                </div>
            </div>

            <!-- Identity Data Card -->
            <div class="bg-paper-white border border-outline-variant rounded shadow-sm overflow-hidden">
                <!-- Card Header -->
                <div class="bg-deep-navy px-6 py-4 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-warm-gold text-[18px]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                        <span class="font-label-md text-label-md text-paper-white uppercase tracking-wider">Identity Record</span>
                    </div>
                    <span class="font-label-sm text-label-sm text-on-primary/70 uppercase">NIMC Database</span>
                </div>

                <!-- Card Body -->
                <div class="p-6 md:p-8 flex flex-col md:flex-row gap-8">

                    <!-- Photo Placeholder -->
                    <div class="shrink-0 flex flex-col items-center gap-3">
                        <div class="w-28 h-32 bg-surface-container rounded border border-outline-variant flex flex-col items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-outline text-[36px]">person</span>
                            <span class="font-label-sm text-[9px] text-slate-gray uppercase tracking-wider">Photo</span>
                        </div>
                        <span class="font-label-sm text-label-sm text-[#34a853] uppercase tracking-wider">Authentic</span>
                    </div>

                    <!-- Details Grid -->
                    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5">
                        <div>
                            <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Full Name</p>
                            <p class="font-body-md text-body-md text-on-surface font-semibold">Johnathan Edward Doe</p>
                        </div>
                        <div>
                            <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Date of Birth</p>
                            <p class="font-body-md text-body-md text-on-surface font-semibold">1985-04-12</p>
                        </div>
                        <div>
                            <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Gender</p>
                            <p class="font-body-md text-body-md text-on-surface">Male</p>
                        </div>
                        <div>
                            <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">State of Origin</p>
                            <p class="font-body-md text-body-md text-on-surface">Lagos</p>
                        </div>
                        <div class="sm:col-span-2">
                            <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Document Hash</p>
                            <p class="font-label-sm text-label-sm text-slate-gray break-all font-mono">e3b0c44298fc1c149afbf4c8996fb924271c</p>
                        </div>
                        <div>
                            <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Match Confidence</p>
                            <div class="flex items-center gap-2">
                                <div class="flex-1 h-1.5 bg-surface-container-high rounded-full overflow-hidden max-w-[80px]">
                                    <div class="h-full bg-[#34a853] rounded-full" style="width: 98%;"></div>
                                </div>
                                <span class="font-label-md text-label-md text-[#34a853]">98%</span>
                            </div>
                        </div>
                        <div>
                            <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-1">Status</p>
                            <span class="inline-flex items-center gap-1.5 bg-[#e6f4ea] text-[#137333] border border-[#ceead6] rounded px-2 py-1 font-label-sm text-label-sm">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#34a853] inline-block"></span>
                                Active
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Privacy Notice -->
            <div class="flex items-start gap-3 bg-surface-container-low border border-outline-variant rounded p-4">
                <span class="material-symbols-outlined text-deep-navy text-[18px] mt-0.5 shrink-0" style="font-variation-settings: 'FILL' 1;">policy</span>
                <p class="font-body-sm text-body-sm text-slate-gray leading-relaxed">
                    This result is subject to NDPR provisions. Personal data retrieved must be used solely for the declared purpose (KYC / Onboarding) and deleted upon processing. Unauthorized retention is prohibited.
                </p>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col md:flex-row gap-4 justify-center">
                <a href="/dashboard/verify/select" class="flex items-center justify-center gap-2 border border-deep-navy text-deep-navy hover:bg-surface-container-low font-label-md text-label-md uppercase py-3 px-8 rounded transition-colors">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    New Verification
                </a>
                <a href="/dashboard" class="flex items-center justify-center gap-2 bg-deep-navy hover:bg-primary text-paper-white font-label-md text-label-md uppercase py-3 px-8 rounded transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">dashboard</span>
                    Back to Dashboard
                </a>
            </div>

            <!-- Timestamp -->
            <div class="text-center">
                <span class="font-label-sm text-[10px] text-slate-gray uppercase tracking-wider">
                    Completed: @DateTime.Now.ToString("dd MMM yyyy, HH:mm") WAT · Logged
                </span>
            </div>
        </div>
    </main>
</div>
