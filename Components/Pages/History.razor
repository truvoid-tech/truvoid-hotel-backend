@page "/history"
@layout DashboardLayout
@rendermode InteractiveServer
@inject ApiClient Api

<PageTitle>History — TruvoID</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex-1 flex flex-col gap-section-gap">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
        <div>
            <h2 class="font-display-lg text-display-lg text-deep-navy mb-2">History</h2>
            <p class="font-body-lg text-body-lg text-slate-gray max-w-2xl">Comprehensive audit trail of all institutional verification activities and ledger movements.</p>
        </div>
        <div class="flex items-center gap-3">
            <button class="flex items-center gap-2 border border-outline-variant bg-surface-container-lowest text-deep-navy px-4 py-2.5 rounded font-label-md text-label-md uppercase tracking-wider hover:bg-surface-variant transition-colors shadow-sm">
                <span class="material-symbols-outlined text-[18px]">download</span>
                Export PDF
            </button>
            <button class="flex items-center gap-2 bg-deep-navy text-on-primary px-4 py-2.5 rounded font-label-md text-label-md uppercase tracking-wider hover:bg-primary transition-colors shadow-sm">
                <span class="material-symbols-outlined text-[18px]">table_view</span>
                Export CSV
            </button>
        </div>
    </div>

    <!-- Tabs & Filters Container -->
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg overflow-hidden shadow-sm">

        <!-- Tabs Row -->
        <div class="flex border-b border-surface-variant bg-surface-container-lowest">
            <button class="flex-1 sm:flex-none px-8 py-4 font-label-md text-label-md uppercase tracking-wider @(ActiveTab == "calls" ? "text-deep-navy border-b-[3px] border-warm-gold" : "text-slate-gray border-b-[3px] border-transparent hover:text-deep-navy hover:bg-surface transition-colors")"
                    @onclick='() => SwitchTab("calls")'>
                Verification Logs
            </button>
            <button class="flex-1 sm:flex-none px-8 py-4 font-label-md text-label-md uppercase tracking-wider @(ActiveTab == "wallet" ? "text-deep-navy border-b-[3px] border-warm-gold" : "text-slate-gray border-b-[3px] border-transparent hover:text-deep-navy hover:bg-surface transition-colors")"
                    @onclick='() => SwitchTab("wallet")'>
                Wallet Transactions
            </button>
        </div>

        <!-- Toolbar / Filters -->
        <div class="p-4 sm:p-6 bg-surface-container-lowest flex flex-col xl:flex-row justify-between items-start xl:items-center gap-4 border-b border-surface-variant">
            <div class="flex items-center gap-3 w-full xl:w-auto">
                <div class="relative w-full xl:w-80">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 transform -translate-y-1/2 text-outline text-[18px]">search</span>
                    <input class="w-full bg-surface border border-outline-variant rounded pl-10 pr-4 py-2 font-body-sm text-body-sm focus:border-deep-navy focus:ring-1 focus:ring-deep-navy outline-none placeholder:text-slate-gray"
                           placeholder="Search reference or staff..." @bind="_searchTerm" @onkeydown="HandleSearch" />
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-3 w-full xl:w-auto">
                <div class="relative">
                    <select class="appearance-none bg-surface border border-outline-variant rounded pl-4 pr-10 py-2 font-body-sm text-body-sm text-deep-navy outline-none focus:border-deep-navy focus:ring-1 focus:ring-deep-navy cursor-pointer"
                            @bind="_filterType">
                        <option value="">All Types</option>
                        <option value="Nin">NIN Verification</option>
                        <option value="Bvn">BVN Check</option>
                        <option value="Phone">Phone Number</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 transform -translate-y-1/2 pointer-events-none text-slate-gray text-[18px]">expand_more</span>
                </div>
                <div class="relative">
                    <select class="appearance-none bg-surface border border-outline-variant rounded pl-4 pr-10 py-2 font-body-sm text-body-sm text-deep-navy outline-none focus:border-deep-navy focus:ring-1 focus:ring-deep-navy cursor-pointer"
                            @bind="_filterStatus">
                        <option value="">All Results</option>
                        <option value="Match">Passed</option>
                        <option value="Error">Failed</option>
                        <option value="NoMatch">No Match</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 transform -translate-y-1/2 pointer-events-none text-slate-gray text-[18px]">expand_more</span>
                </div>
            </div>
        </div>

        @if (ActiveTab == "calls")
        {
            <!-- Verification Logs Table -->
            <div class="w-full overflow-x-auto table-scroll bg-surface-container-lowest">
                <table class="w-full text-left border-collapse min-w-[900px]">
                    <thead>
                        <tr>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] w-48 font-medium">Date / Time</th>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] font-medium">Verification Type</th>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] font-medium">Subject Reference</th>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] font-medium">Staff Member</th>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] text-right font-medium">Result</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-variant bg-surface-container-lowest">
                        @if (_calls?.Items?.Any() == true)
                        {
                            @foreach (var call in _calls.Items)
                            {
                                <tr class="hover:bg-surface-bright transition-colors group">
                                    <td class="py-4 px-6">
                                        <div class="font-body-sm text-[14px] text-deep-navy">@call.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        <div class="font-label-sm text-[11px] text-slate-gray mt-0.5 tracking-wider">@call.CreatedAt.ToString("HH:mm:ss") UTC</div>
                                    </td>
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-slate-gray text-[18px]">@(call.Type == VerificationType.Nin ? "badge" : call.Type == VerificationType.Bvn ? "account_balance" : "phone_iphone")</span>
                                            <span class="font-body-sm text-[14px] text-deep-navy">@(call.Type == VerificationType.Nin ? "NIN Verification" : call.Type == VerificationType.Bvn ? "BVN Check" : "Phone Number")</span>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6">
                                        <span class="font-label-md text-[12px] text-slate-gray bg-surface px-2 py-1 rounded border border-surface-variant">@(call.IdempotencyKey?.Length > 12 ? call.IdempotencyKey[..12] + "..." : call.Id.ToString()[..8])</span>
                                    </td>
                                    <td class="py-4 px-6 font-body-sm text-[14px] text-deep-navy">@(call.ApiKeyId.HasValue ? "System API" : "Dashboard User")</td>
                                    <td class="py-4 px-6 text-right">
                                        @if (call.Status == VerificationStatus.Match)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-primary-fixed/30 text-deep-navy font-label-sm text-[11px] uppercase tracking-wider border border-primary-fixed">
                                                <span class="material-symbols-outlined text-[14px]">check_circle</span>
                                                Match
                                            </span>
                                        }
                                        else if (call.Status == VerificationStatus.NoMatch)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-surface-variant/50 text-slate-gray font-label-sm text-[11px] uppercase tracking-wider border border-surface-variant">
                                                <span class="material-symbols-outlined text-[14px]">do_not_disturb_on</span>
                                                No Match
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-error-container/50 text-error font-label-sm text-[11px] uppercase tracking-wider border border-error-container">
                                                <span class="material-symbols-outlined text-[14px]">error</span>
                                                Failed
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center">
                                    <span class="material-symbols-outlined text-outline-variant text-[48px] mb-4 block">inbox</span>
                                    <p class="font-body-md text-body-md text-slate-gray">No verification logs found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (_calls is not null && _calls.TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-surface-variant bg-surface-container-lowest flex items-center justify-between">
                    <span class="font-body-sm text-[14px] text-slate-gray">Showing @((_calls.Page - 1) * _calls.PageSize + 1)-@Math.Min(_calls.Page * _calls.PageSize, _calls.TotalCount) of @_calls.TotalCount logs</span>
                    <div class="flex items-center gap-2">
                        <button class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant text-slate-gray hover:bg-surface-variant transition-colors disabled:opacity-50"
                                disabled="@(!_calls.HasPrevious)" @onclick="PreviousPage">
                            <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                        </button>
                        @for (var i = 1; i <= Math.Min(_calls.TotalPages, 3); i++)
                        {
                            var pageNum = i;
                            <button class="w-8 h-8 flex items-center justify-center rounded border font-label-sm text-[12px] transition-colors @(pageNum == _calls.Page ? "border-deep-navy bg-deep-navy text-on-primary" : "border-outline-variant text-slate-gray hover:bg-surface")"
                                    @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        }
                        @if (_calls.TotalPages > 3)
                        {
                            <span class="text-slate-gray font-label-sm text-[12px] px-1">...</span>
                        }
                        <button class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant text-slate-gray hover:bg-surface-variant transition-colors disabled:opacity-50"
                                disabled="@(!_calls.HasNext)" @onclick="NextPage">
                            <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Wallet Transactions Tab -->
            <div class="w-full overflow-x-auto table-scroll bg-surface-container-lowest">
                <table class="w-full text-left border-collapse min-w-[800px]">
                    <thead>
                        <tr>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] w-48 font-medium">Date / Time</th>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] font-medium">Type</th>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] font-medium">Description</th>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] font-medium text-right">Amount</th>
                            <th class="border-b border-surface-variant bg-surface py-3 px-6 font-label-sm text-[11px] text-slate-gray uppercase tracking-[0.05em] font-medium text-right">Balance After</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-variant bg-surface-container-lowest">
                        @if (_transactions?.Any() == true)
                        {
                            @foreach (var tx in _transactions)
                            {
                                <tr class="hover:bg-surface-bright transition-colors group">
                                    <td class="py-4 px-6">
                                        <div class="font-body-sm text-[14px] text-deep-navy">@tx.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        <div class="font-label-sm text-[11px] text-slate-gray mt-0.5 tracking-wider">@tx.CreatedAt.ToString("HH:mm:ss") UTC</div>
                                    </td>
                                    <td class="py-4 px-6">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded font-label-sm text-[11px] uppercase tracking-wider @(tx.Type == WalletTransactionType.Credit ? "bg-primary-fixed/30 text-deep-navy border border-primary-fixed" : tx.Type == WalletTransactionType.Debit ? "bg-error-container/50 text-error border border-error-container" : "bg-surface-variant/50 text-slate-gray border border-surface-variant")">
                                            <span class="material-symbols-outlined text-[14px]">@(tx.Type == WalletTransactionType.Credit ? "add_circle" : tx.Type == WalletTransactionType.Debit ? "remove_circle" : "undo")</span>
                                            @tx.Type
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 font-body-sm text-[14px] text-deep-navy">@(tx.Description ?? "—")</td>
                                    <td class="py-4 px-6 text-right font-label-md text-[12px] @(tx.Type == WalletTransactionType.Credit ? "text-green-700" : "text-error")">
                                        @(tx.Type == WalletTransactionType.Credit ? "+" : "-")₦@tx.Amount.ToString("N2")
                                    </td>
                                    <td class="py-4 px-6 text-right font-label-md text-[12px] text-deep-navy">₦@tx.BalanceAfter.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center">
                                    <span class="material-symbols-outlined text-outline-variant text-[48px] mb-4 block">receipt_long</span>
                                    <p class="font-body-md text-body-md text-slate-gray">No wallet transactions found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private string ActiveTab = "calls";
    private string _searchTerm = string.Empty;
    private string _filterType = string.Empty;
    private string _filterStatus = string.Empty;
    private int _currentPage = 1;
    private PaginatedResponse<CallHistoryResponse>? _calls;
    private List<WalletTransactionResponse>? _transactions;

    protected override async Task OnInitializedAsync()
    {
        await LoadCalls();
    }

    private void SwitchTab(string tab)
    {
        ActiveTab = tab;
        if (tab == "calls") _ = LoadCalls();
        else _ = LoadTransactions();
    }

    private async Task LoadCalls()
    {
        try
        {
            var queryParams = $"?page={_currentPage}&pageSize=10";
            if (!string.IsNullOrEmpty(_filterType))
                queryParams += $"&type={_filterType}";
            if (!string.IsNullOrEmpty(_filterStatus))
                queryParams += $"&status={_filterStatus}";

            _calls = await Api.GetAsync<PaginatedResponse<CallHistoryResponse>>($"/v1/calls{queryParams}");
        }
        catch
        {
            _calls = new PaginatedResponse<CallHistoryResponse>();
        }
    }

    private async Task LoadTransactions()
    {
        try
        {
            _transactions = await Api.GetAsync<List<WalletTransactionResponse>>($"/v1/wallet/transactions?page={_currentPage}&pageSize=10");
        }
        catch
        {
            _transactions = new List<WalletTransactionResponse>();
        }
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadCalls();
        }
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1) { _currentPage--; await LoadCalls(); }
    }

    private async Task NextPage()
    {
        _currentPage++; await LoadCalls();
    }

    private async Task GoToPage(int page)
    {
        _currentPage = page; await LoadCalls();
    }
}
