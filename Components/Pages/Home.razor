@page "/"

<PageTitle>TruvoID — KYC-as-a-Service</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1>TruvoID</h1>
            <p class="lead">KYC-as-a-Service Platform by Slogani Consults</p>
            <hr />
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">NIN Verification</h5>
                    <p class="card-text">Verify National Identification Numbers against NIMC records.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">BVN Verification</h5>
                    <p class="card-text">Verify Bank Verification Numbers for financial institution onboarding.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Phone Verification</h5>
                    <p class="card-text">Verify phone number ownership for identity confirmation.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="alert alert-info">
                <strong>Note:</strong> TruvoID is an authorized reseller of NIMC verification services.
                This platform is operated by Slogani Consults and is not a government service.
            </div>
        </div>
    </div>
</div>
