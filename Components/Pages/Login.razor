@page "/login"
@layout OnboardingLayout
@rendermode InteractiveServer
@inject ApiClient Api
@inject TokenService TokenService
@inject TruvoIDAuthStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>TruvoID — Sign In</PageTitle>

<div class="bg-background text-on-background min-h-screen flex items-center justify-center p-margin-mobile md:p-margin-desktop font-body-md">
    <div class="w-full max-w-[1200px] grid md:grid-cols-2 gap-gutter md:gap-section-gap">

        <!-- Left: Brand -->
        <div class="hidden md:flex flex-col justify-center max-w-md">
            <h1 class="font-display-lg text-display-lg text-deep-navy mb-unit">TruvoID</h1>
            <p class="font-body-lg text-body-lg text-slate-gray mb-section-gap">Institutional Verification</p>
            <div class="space-y-6">
                <div>
                    <h3 class="font-headline-lg text-headline-lg text-on-background mb-4">Welcome Back</h3>
                    <p class="font-body-md text-body-md text-slate-gray">
                        Sign in to access your verification dashboard, manage API keys, and monitor your institution's identity verification activity.
                    </p>
                </div>
                <div class="flex items-center gap-4 text-deep-navy">
                    <span class="material-symbols-outlined">shield</span>
                    <span class="font-label-md text-label-md uppercase">End-to-End Encrypted</span>
                </div>
            </div>
        </div>

        <!-- Right: Form -->
        <div class="bg-paper-white border border-outline-variant rounded shadow-sm p-6 md:p-12 relative flex flex-col justify-center">
            <div class="md:hidden mb-8">
                <h1 class="font-headline-lg text-headline-lg text-deep-navy mb-1">TruvoID</h1>
                <h2 class="font-headline-md text-headline-md text-on-background">Sign In</h2>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded text-red-700 font-body-sm text-body-sm">
                    <span class="material-symbols-outlined text-[16px] align-middle mr-1">error</span>
                    @_errorMessage
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleLogin" class="space-y-6">
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="email">Email Address</label>
                    <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent px-3 py-2 font-body-md text-body-md text-on-background"
                           id="email" @bind="_model.Email" type="email" placeholder="jane.doe@institution.com" required />
                </div>

                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="password">Password</label>
                    <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent px-3 py-2 font-body-md text-body-md text-on-background"
                           id="password" @bind="_model.Password" type="password" placeholder="••••••••" required />
                </div>

                <div class="flex items-center justify-between text-sm">
                    <a href="/forgot-password" class="font-label-sm text-label-sm text-deep-navy hover:underline">Forgot password?</a>
                </div>

                <button type="submit" disabled="@_isLoading"
                        class="w-full bg-deep-navy text-paper-white font-label-md text-label-md uppercase px-6 py-3 rounded hover:bg-ink transition-colors flex items-center justify-center gap-2 disabled:opacity-50">
                    @if (_isLoading)
                    {
                        <div class="spinner"></div>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    }
                </button>
            </EditForm>

            <div class="mt-8 text-center border-t border-surface-container-high pt-6">
                <p class="font-body-sm text-body-sm text-slate-gray">
                    New institution? <a href="/onboarding" class="text-deep-navy font-medium hover:underline">Request Access</a>
                </p>
            </div>

            <div class="absolute top-0 right-0 w-32 h-1 bg-warm-gold rounded-tr"></div>
        </div>
    </div>
</div>

<style>
    .spinner {
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        border-top: 2px solid #fff;
        width: 16px;
        height: 16px;
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .input-bespoke:focus {
        border-color: #1f3864;
        box-shadow: inset 0 0 0 1px #1f3864;
        outline: none;
    }
</style>

@code {
    private LoginModel _model = new();
    private bool _isLoading;
    private string? _errorMessage;

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Api.PostAsync<LoginResponse>("/v1/auth/login", _model);

            if (response is null)
            {
                _errorMessage = "Invalid email or password.";
                return;
            }

            await TokenService.SetTokensAsync(response.AccessToken, response.RefreshToken, response.ExpiresAt);
            AuthState.NotifyAuthenticationStateChanged();
            Nav.NavigateTo("/dashboard");
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                ? "Invalid email or password."
                : "Unable to connect. Please try again.";
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
