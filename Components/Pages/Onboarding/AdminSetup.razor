@page "/onboarding/admin"
@layout OnboardingLayout

<PageTitle>TruvoID — Primary Admin Setup</PageTitle>

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .input-bespoke:focus {
        border-color: #1f3864;
        box-shadow: inset 0 0 0 1px #1f3864;
        outline: none;
    }
</style>

<div class="bg-background text-on-background min-h-screen flex items-center justify-center p-margin-mobile md:p-margin-desktop font-body-md text-body-md">
    <div class="w-full max-w-[1200px] grid md:grid-cols-2 gap-gutter md:gap-section-gap">

        <!-- Left: Editorial Context -->
        <div class="hidden md:flex flex-col justify-center max-w-md">
            <h1 class="font-display-lg text-display-lg text-deep-navy mb-unit">TruvoID</h1>
            <p class="font-body-lg text-body-lg text-slate-gray mb-section-gap">Institutional Verification</p>
            <div class="space-y-6">
                <div>
                    <h2 class="font-headline-md text-headline-md text-warm-gold mb-2">Step 3 of 7</h2>
                    <h3 class="font-headline-lg text-headline-lg text-on-background mb-4">Primary Admin Setup</h3>
                    <p class="font-body-md text-body-md text-slate-gray">
                        Establish the foundational administrative credentials for your institution. This account will have supreme authority over subsequent team deployments, compliance configurations, and funding protocols. Security is paramount.
                    </p>
                </div>
                <div class="flex items-center gap-4 text-deep-navy">
                    <span class="material-symbols-outlined">shield</span>
                    <span class="font-label-md text-label-md uppercase">End-to-End Encrypted Verification</span>
                </div>
            </div>
        </div>

        <!-- Right: Form Canvas -->
        <div class="bg-paper-white border border-outline-variant rounded shadow-sm p-6 md:p-12 relative flex flex-col justify-center">
            <div class="md:hidden mb-8">
                <h1 class="font-headline-lg text-headline-lg text-deep-navy mb-1">TruvoID</h1>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-widest mb-4">Step 3 of 7</p>
                <h2 class="font-headline-md text-headline-md text-on-background">Admin Setup</h2>
            </div>

            <!-- Progress bar -->
            <div class="flex gap-2 mb-8">
                <div class="h-1 flex-1 bg-deep-navy rounded-full"></div>
                <div class="h-1 flex-1 bg-deep-navy rounded-full"></div>
                <div class="h-1 flex-1 bg-deep-navy rounded-full"></div>
                <div class="h-1 flex-1 bg-surface-container-high rounded-full"></div>
                <div class="h-1 flex-1 bg-surface-container-high rounded-full"></div>
                <div class="h-1 flex-1 bg-surface-container-high rounded-full"></div>
                <div class="h-1 flex-1 bg-surface-container-high rounded-full"></div>
            </div>

            <form class="space-y-6">
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="fullName">Full Name</label>
                    <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent px-3 py-2 font-body-md text-body-md text-on-background" id="fullName" placeholder="Jane Doe" type="text">
                </div>

                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="workEmail">Work Email</label>
                    <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent px-3 py-2 font-body-md text-body-md text-on-background" id="workEmail" placeholder="jane.doe@institution.com" type="email">
                </div>

                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="phone">Phone Number</label>
                    <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent px-3 py-2 font-body-md text-body-md text-on-background" id="phone" placeholder="+234 800 000 0000" type="tel">
                </div>

                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="password">Secure Password</label>
                    <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent px-3 py-2 font-body-md text-body-md text-on-background" id="password" placeholder="••••••••••••" type="password">
                    <p class="font-label-sm text-label-sm text-outline mt-1 text-right">Must contain uppercase, number, and symbol.</p>
                </div>

                <div class="mt-8 pt-6 border-t border-surface-container-high">
                    <p class="font-label-sm text-label-sm text-slate-gray mb-3 uppercase flex items-center gap-2">
                        <span class="material-symbols-outlined text-warm-gold text-[16px]">key</span>
                        Authentication Required
                    </p>
                    <p class="font-body-sm text-body-sm text-slate-gray mb-4">
                        A verification code will be sent to the provided phone number upon submission.
                    </p>
                </div>

                <div class="flex items-center justify-between pt-4">
                    <a href="/onboarding/business" class="font-label-md text-label-md text-slate-gray hover:text-deep-navy transition-colors uppercase">
                        Back
                    </a>
                    <a href="/onboarding/compliance" class="bg-deep-navy text-paper-white font-label-md text-label-md uppercase px-6 py-3 rounded hover:bg-ink transition-colors flex items-center gap-2">
                        Continue to Compliance <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </a>
                </div>
            </form>

            <div class="absolute top-0 right-0 w-32 h-1 bg-warm-gold rounded-tr"></div>
        </div>
    </div>
</div>
