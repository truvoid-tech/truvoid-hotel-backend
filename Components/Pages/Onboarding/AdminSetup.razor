@page "/onboarding/admin"
@layout OnboardingLayout
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>TruvoID — Primary Admin Setup</PageTitle>

<style>
    .input-bespoke:focus {
        border-color: #1f3864;
        box-shadow: inset 0 0 0 1px #1f3864;
        outline: none;
    }
</style>

<div class="bg-background text-on-background min-h-screen flex items-center justify-center p-margin-mobile md:p-margin-desktop font-body-md text-body-md">
    <div class="w-full max-w-[1200px] grid md:grid-cols-2 gap-gutter md:gap-section-gap">

        <!-- Left: Editorial Context -->
        <div class="hidden md:flex flex-col justify-center max-w-md">
            <h1 class="font-display-lg text-display-lg text-deep-navy mb-unit">TruvoID</h1>
            <p class="font-body-lg text-body-lg text-slate-gray mb-section-gap">Institutional Verification</p>
            <div class="space-y-6">
                <div>
                    <h2 class="font-headline-md text-headline-md text-warm-gold mb-2">Step 3 of 7</h2>
                    <h3 class="font-headline-lg text-headline-lg text-on-background mb-4">Primary Admin Setup</h3>
                    <p class="font-body-md text-body-md text-slate-gray">
                        Establish the foundational administrative credentials for your institution. This account will have supreme authority over subsequent team deployments, compliance configurations, and funding protocols.
                    </p>
                </div>
                <div class="flex items-center gap-4 text-deep-navy">
                    <span class="material-symbols-outlined">shield</span>
                    <span class="font-label-md text-label-md uppercase">End-to-End Encrypted Verification</span>
                </div>
            </div>
        </div>

        <!-- Right: Form Canvas -->
        <div class="bg-paper-white border border-outline-variant rounded shadow-sm p-6 md:p-12 relative flex flex-col justify-center">
            <!-- Progress bar -->
            <div class="flex gap-2 mb-8">
                <div class="h-1 flex-1 bg-deep-navy rounded-full"></div>
                <div class="h-1 flex-1 bg-deep-navy rounded-full"></div>
                <div class="h-1 flex-1 bg-deep-navy rounded-full"></div>
                <div class="h-1 flex-1 bg-surface-container-high rounded-full"></div>
                <div class="h-1 flex-1 bg-surface-container-high rounded-full"></div>
                <div class="h-1 flex-1 bg-surface-container-high rounded-full"></div>
                <div class="h-1 flex-1 bg-surface-container-high rounded-full"></div>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded text-red-700 font-body-sm text-body-sm">@_errorMessage</div>
            }

            <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded text-green-700 font-body-sm text-body-sm">
                <span class="material-symbols-outlined text-[16px] align-middle mr-1">check_circle</span>
                Your account has been created. Admin credentials are set during registration.
            </div>

            <p class="font-body-sm text-body-sm text-slate-gray mb-4">
                Your admin account was established during registration. You can update your institution name below or proceed to compliance.
            </p>

            <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="space-y-6">
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="instName">Institution Name</label>
                    <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent px-3 py-2 font-body-md text-body-md text-on-background"
                           id="instName" @bind="_model.Name" placeholder="Your Institution Name" />
                </div>

                <div class="flex items-center justify-between pt-4">
                    <a href="/onboarding/business" class="font-label-md text-label-md text-slate-gray hover:text-deep-navy transition-colors uppercase">
                        Back
                    </a>
                    <button type="submit" disabled="@_isLoading" class="bg-deep-navy text-paper-white font-label-md text-label-md uppercase px-6 py-3 rounded hover:bg-ink transition-colors flex items-center gap-2 disabled:opacity-50">
                        @(_isLoading ? "Saving..." : "Continue to Compliance")
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </button>
                </div>
            </EditForm>

            <div class="absolute top-0 right-0 w-32 h-1 bg-warm-gold rounded-tr"></div>
        </div>
    </div>
</div>

@code {
    private InstitutionModel _model = new();
    private bool _isLoading;
    private string? _errorMessage;

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Api.PutRawAsync("/v1/onboarding/institution", _model);
            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/onboarding/compliance");
            }
            else
            {
                _errorMessage = await ApiClient.GetErrorMessageAsync(response);
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to save. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class InstitutionModel
    {
        public string Name { get; set; } = string.Empty;
        public string ContactEmail { get; set; } = string.Empty;
        public string ContactPhone { get; set; } = string.Empty;
    }
}
