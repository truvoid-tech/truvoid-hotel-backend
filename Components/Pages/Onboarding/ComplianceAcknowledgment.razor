@page "/onboarding/compliance"
@layout OnboardingLayout

<PageTitle>TruvoID — Regulatory Acknowledgment</PageTitle>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #e0e3e6; border-radius: 4px; }
</style>

<div class="bg-surface text-on-surface min-h-screen flex flex-col font-body-md antialiased">
    <main class="flex-grow flex flex-col items-center justify-center p-margin-mobile md:p-margin-desktop">

        <!-- Stepper -->
        <div class="w-full max-w-3xl mb-section-gap">
            <div class="flex items-center justify-between relative">
                <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-0.5 bg-surface-variant z-0"></div>
                <div class="absolute left-0 top-1/2 -translate-y-1/2 h-0.5 bg-deep-navy z-0 transition-all duration-500" style="width: 42.85%;"></div>
                @for (int i = 1; i <= 3; i++)
                {
                    <div class="relative z-10 flex flex-col items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-deep-navy flex items-center justify-center">
                            <span class="material-symbols-outlined text-[14px] text-white" style="font-variation-settings: 'FILL' 1;">check</span>
                        </div>
                    </div>
                }
                <!-- Step 4 (current) -->
                <div class="relative z-10 flex flex-col items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-deep-navy border-2 border-surface flex items-center justify-center shadow-[0_0_0_2px_#1f3864]">
                        <span class="font-label-sm text-label-sm text-white">4</span>
                    </div>
                </div>
                @for (int i = 5; i <= 7; i++)
                {
                    <div class="relative z-10 flex flex-col items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-surface-variant border border-outline-variant flex items-center justify-center"></div>
                    </div>
                }
            </div>
            <div class="text-center mt-4 font-label-sm text-label-sm text-outline tracking-widest uppercase">Step 4 of 7: Compliance Acknowledgment</div>
        </div>

        <!-- Compliance Card -->
        <div class="w-full max-w-3xl bg-paper-white border border-surface-variant rounded-DEFAULT shadow-[0_12px_32px_-4px_rgba(31,56,100,0.05)] relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-[2px] bg-warm-gold"></div>
            <div class="p-8 md:p-12">
                <div class="flex items-center gap-4 mb-8">
                    <div class="p-3 bg-surface-container rounded-DEFAULT">
                        <span class="material-symbols-outlined text-deep-navy text-2xl" style="font-variation-settings: 'FILL' 1;">gavel</span>
                    </div>
                    <div>
                        <h1 class="font-headline-lg text-headline-lg text-on-surface mb-1">Regulatory Acknowledgment</h1>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Please review and accept the terms governing data processing and authorized access.</p>
                    </div>
                </div>

                <!-- Terms -->
                <div class="bg-surface p-6 border border-surface-variant rounded-DEFAULT mb-8 h-64 overflow-y-auto custom-scrollbar">
                    <h3 class="font-label-md text-label-md text-deep-navy uppercase mb-4 tracking-wider">1. Authorized Reseller Status</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-6 leading-relaxed">
                        TruvoID operates as an independent authorized verification partner and reseller of identity verification services. TruvoID is not the National Identity Management Commission (NIMC) nor is it a direct agency of the Federal Government of Nigeria. By utilizing this service, you acknowledge that TruvoID acts as an intermediary for authorized verification requests in compliance with established national frameworks.
                    </p>
                    <h3 class="font-label-md text-label-md text-deep-navy uppercase mb-4 tracking-wider">2. NDPR Compliance &amp; Data Processing</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-4 leading-relaxed">
                        In accordance with the Nigeria Data Protection Regulation (NDPR) and other applicable data privacy laws, explicit consent must be obtained prior to the processing, storage, or transmission of personally identifiable information (PII).
                    </p>
                    <ul class="list-disc pl-5 font-body-sm text-body-sm text-on-surface-variant mb-6 space-y-2">
                        <li>Data will only be processed for the specific purpose of identity verification.</li>
                        <li>Audit logs of all verification queries are maintained for regulatory compliance.</li>
                        <li>Unauthorized querying of individuals' data without their prior consent is strictly prohibited and may result in immediate suspension of access and legal action.</li>
                    </ul>
                </div>

                <!-- Consent Checkboxes -->
                <div class="space-y-4 mb-10">
                    <label class="flex items-start gap-4 p-4 border border-surface-variant rounded-DEFAULT hover:bg-surface transition-colors cursor-pointer group">
                        <div class="flex-shrink-0 mt-0.5">
                            <input class="w-5 h-5 rounded-sm border-outline text-deep-navy focus:ring-deep-navy focus:ring-offset-0 bg-transparent transition-all" type="checkbox">
                        </div>
                        <div>
                            <span class="block font-label-md text-label-md text-on-surface mb-1 group-hover:text-deep-navy transition-colors">I acknowledge TruvoID's operational status.</span>
                            <span class="block font-body-sm text-body-sm text-on-surface-variant">I understand that TruvoID is an authorized reseller and not the NIMC.</span>
                        </div>
                    </label>
                    <label class="flex items-start gap-4 p-4 border border-surface-variant rounded-DEFAULT hover:bg-surface transition-colors cursor-pointer group">
                        <div class="flex-shrink-0 mt-0.5">
                            <input class="w-5 h-5 rounded-sm border-outline text-deep-navy focus:ring-deep-navy focus:ring-offset-0 bg-transparent transition-all" type="checkbox">
                        </div>
                        <div>
                            <span class="block font-label-md text-label-md text-on-surface mb-1 group-hover:text-deep-navy transition-colors">I agree to the Data Processing Terms.</span>
                            <span class="block font-body-sm text-body-sm text-on-surface-variant">I commit to obtaining necessary subject consent prior to executing verification requests as required by NDPR.</span>
                        </div>
                    </label>
                </div>

                <!-- Actions -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-surface-variant">
                    <a href="/onboarding/admin" class="w-full sm:w-auto px-6 py-3 font-label-md text-label-md text-deep-navy uppercase tracking-wider border-[1.5px] border-deep-navy rounded-DEFAULT hover:bg-surface-variant transition-colors flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                        Go Back
                    </a>
                    <a href="/onboarding/wallet" class="w-full sm:w-auto px-8 py-3 font-label-md text-label-md text-white uppercase tracking-wider bg-deep-navy rounded-DEFAULT hover:bg-primary transition-colors flex items-center justify-center gap-2">
                        Confirm &amp; Continue
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="mt-8 text-center">
            <div class="inline-flex items-center gap-2 font-label-sm text-label-sm text-outline-variant">
                <span class="material-symbols-outlined text-[16px]">lock</span>
                SECURE INSTITUTIONAL ONBOARDING
            </div>
        </div>
    </main>
</div>
