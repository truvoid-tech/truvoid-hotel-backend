@page "/onboarding/verify"
@layout OnboardingLayout

<PageTitle>TruvoID — Run Your First Verification</PageTitle>

<style>
    .mock-result {
        display: none;
        opacity: 0;
        transition: opacity 0.5s ease-in-out;
    }
    .mock-result.visible {
        display: block;
        opacity: 1;
    }
    .spinner {
        display: none;
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        border-top: 2px solid #fff;
        width: 16px;
        height: 16px;
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<div class="min-h-screen flex flex-col justify-center items-center p-4 md:p-8 bg-background text-on-background">
    <div class="w-full max-w-4xl mx-auto flex flex-col items-center">

        <!-- Progress -->
        <div class="text-center mb-4">
            <span class="font-label-md text-label-md text-surface-tint uppercase tracking-wider">Step 7 of 7: Final Sandbox Test</span>
        </div>
        <div class="mb-section-gap w-full flex justify-center items-center gap-2">
            @for (int i = 0; i < 7; i++)
            {
                <div class="h-1 w-8 bg-primary rounded"></div>
            }
        </div>

        <div class="text-center mb-12">
            <h1 class="font-headline-lg text-headline-lg md:font-display-lg md:text-display-lg text-primary mb-4">Run Your First Verification</h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
                This is a safe, sandboxed environment. Try looking up a mock National Identity Number to see how results are structured before going live.
            </p>
        </div>

        <!-- Bento Grid -->
        <div class="w-full grid grid-cols-1 md:grid-cols-12 gap-gutter mb-section-gap">

            <!-- Input Card -->
            <div class="md:col-span-5 bg-paper-white border border-outline-variant rounded p-8 shadow-sm">
                <div class="flex items-center gap-2 mb-6">
                    <span class="material-symbols-outlined text-warm-gold" style="font-variation-settings: 'FILL' 1;">science</span>
                    <h2 class="font-label-md text-label-md uppercase text-primary">Sandbox Environment</h2>
                </div>
                <div class="mb-6">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2">TARGET ENTITY (MOCK DATA)</label>
                    <div class="p-3 bg-surface-container-low border border-outline-variant rounded flex items-center justify-between">
                        <span class="font-body-md text-body-md text-on-surface">John Doe</span>
                        <span class="font-label-sm text-label-sm text-outline px-2 py-1 bg-surface-container rounded">PRE-FILLED</span>
                    </div>
                </div>
                <div class="mb-8">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2">NATIONAL IDENTITY NUMBER</label>
                    <input class="w-full p-3 bg-surface-container-low border border-outline-variant rounded font-label-md text-label-md text-primary focus:outline-none focus:border-deep-navy focus:ring-1 focus:ring-deep-navy transition-colors" readonly type="text" value="12345678901">
                    <p class="mt-2 font-body-sm text-body-sm text-outline">Use this test NIN to trigger a successful match.</p>
                </div>
                <button class="w-full bg-deep-navy hover:bg-primary-container text-on-primary font-label-md text-label-md uppercase py-4 px-6 rounded transition-colors flex items-center justify-center gap-2" id="testVerifyBtn" type="button">
                    <span class="material-symbols-outlined">task_alt</span>
                    <span class="button-text">Try Test Verification</span>
                    <div class="spinner"></div>
                </button>
            </div>

            <!-- Result Card -->
            <div class="md:col-span-7 bg-surface-container-lowest border border-outline-variant rounded p-8 relative overflow-hidden min-h-[400px]">
                <!-- Empty State -->
                <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-8" id="emptyState">
                    <span class="material-symbols-outlined text-outline-variant mb-4" style="font-size: 48px;">plagiarism</span>
                    <p class="font-body-md text-body-md text-on-surface-variant max-w-sm">Results will appear here. Click 'Try Test Verification' to see how TruvoID presents structured identity data.</p>
                </div>
                <!-- Mock Result -->
                <div class="mock-result w-full h-full flex flex-col" id="mockResult">
                    <div class="flex items-center justify-between border-b border-outline-variant pb-4 mb-6">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span class="material-symbols-outlined text-surface-tint" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                                <h3 class="font-headline-md text-headline-md text-primary">Identity Verified</h3>
                            </div>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">Transaction ID: TRV-SBX-0987654</p>
                        </div>
                        <div class="bg-[#e6f4ea] text-[#137333] font-label-sm text-label-sm px-3 py-1 rounded border border-[#ceead6]">MATCH CONFIRMED</div>
                    </div>
                    <div class="grid grid-cols-2 gap-x-8 gap-y-6">
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">FULL NAME</label>
                            <p class="font-body-md text-body-md text-on-surface">Johnathan Edward Doe</p>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">DATE OF BIRTH</label>
                            <p class="font-body-md text-body-md text-on-surface">1985-04-12</p>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">NIN HASH</label>
                            <p class="font-label-sm text-label-sm text-slate-gray break-all">e3b0c44298fc1c149afbf4c8996fb924</p>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">STATUS</label>
                            <p class="font-body-md text-body-md text-on-surface">Active</p>
                        </div>
                    </div>
                    <div class="mt-auto pt-6 border-t border-outline-variant flex justify-end">
                        <a href="/" class="bg-warm-gold hover:opacity-90 text-on-primary font-label-md text-label-md uppercase py-3 px-6 rounded transition-opacity">
                            Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('testVerifyBtn').addEventListener('click', function () {
        const btn = this;
        const btnText = btn.querySelector('.button-text');
        const spinner = btn.querySelector('.spinner');
        const emptyState = document.getElementById('emptyState');
        const mockResult = document.getElementById('mockResult');

        btnText.textContent = 'Verifying...';
        spinner.style.display = 'block';
        btn.disabled = true;
        btn.classList.add('opacity-80');

        setTimeout(() => {
            btnText.textContent = 'Verification Complete';
            spinner.style.display = 'none';
            emptyState.style.display = 'none';
            mockResult.classList.add('visible');
        }, 1200);
    });
</script>
