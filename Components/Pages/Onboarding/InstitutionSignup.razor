@page "/onboarding"
@layout OnboardingLayout
@rendermode InteractiveServer
@inject ApiClient Api
@inject TokenService TokenService
@inject TruvoIDAuthStateProvider AuthState
@inject NavigationManager Nav
@inject TruvoIDAuthStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>TruvoID — Request Access</PageTitle>

<div class="bg-background text-on-background font-body-md antialiased selection:bg-deep-navy selection:text-paper-white flex flex-col md:flex-row min-h-screen">

    <!-- Left: Brand / Editorial panel — full height, content anchored to bottom -->
    <div class="hidden md:flex md:w-1/2 lg:w-[45%] min-h-screen relative overflow-hidden flex-col justify-end p-12"
         style="background-image: url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80'); background-size: cover; background-position: center;">

        <!-- Deep-navy overlay — heavier at bottom for legibility -->
        <div class="absolute inset-0 z-0" style="background: linear-gradient(to top, rgba(31,56,100,0.97) 0%, rgba(31,56,100,0.75) 45%, rgba(31,56,100,0.40) 100%);"></div>

        <!-- Editorial content — bottom left -->
        <div class="relative z-10 max-w-md">
            <h1 class="font-headline-md text-headline-md font-bold text-paper-white tracking-tight mb-4">TruvoID</h1>
            <p class="font-headline-lg text-headline-lg text-paper-white mb-4 leading-snug">Institutional Identity Infrastructure.</p>
            <p class="font-body-lg text-body-lg text-paper-white/70">A definitive platform for secure, compliance-ready enterprise identity verification and management.</p>
        </div>
    </div>

    <!-- Right: Form -->
    <div class="flex-1 flex flex-col justify-center items-center p-margin-mobile md:p-margin-desktop h-full overflow-y-auto bg-background">
        <div class="w-full max-w-md">
            <div class="md:hidden mb-12">
                <h1 class="font-headline-md text-headline-md font-bold text-deep-navy tracking-tight">TruvoID</h1>
            </div>

            <div class="mb-10">
                <div class="flex items-center gap-2 mb-6">
                    <div class="flex items-center justify-center w-8 h-8 rounded-full bg-deep-navy text-paper-white font-label-sm text-label-sm">1</div>
                    <div class="flex flex-col">
                        <span class="text-label-sm font-label-sm text-slate-gray uppercase tracking-widest">Step 1 of 7</span>
                        <span class="text-body-sm font-medium text-deep-navy">Institutional Profile</span>
                    </div>
                    <div class="flex-1 h-1 bg-surface-container-high ml-4 rounded-full overflow-hidden">
                        <div class="bg-deep-navy h-full w-[14.28%]"></div>
                    </div>
                </div>
                <h2 class="font-headline-lg text-headline-lg text-deep-navy mb-2">Request Access</h2>
                <p class="font-body-md text-body-md text-slate-gray">Begin the institutional verification process by submitting your organizational details below.</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded text-red-700 font-body-sm text-body-sm">
                    @_errorMessage
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleSignup" class="space-y-6">
                <!-- Legal Business Name -->
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray uppercase mb-2" for="businessName">Legal Business Name</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">domain</span>
                        <InputText class="w-full bg-paper-white border border-surface-container-high rounded-DEFAULT pl-10 pr-4 py-3 font-body-md text-body-md text-on-background focus:ring-1 focus:ring-deep-navy focus:border-deep-navy transition-colors outline-none" id="businessName" @bind-Value="_model.InstitutionName" placeholder="e.g. Acme Financial Holdings LLC" />
                    </div>
                </div>

                <!-- Business Email -->
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray uppercase mb-2" for="email">Primary Contact Email</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">mail</span>
                        <InputText class="w-full bg-paper-white border border-surface-container-high rounded-DEFAULT pl-10 pr-4 py-3 font-body-md text-body-md text-on-background focus:ring-1 focus:ring-deep-navy focus:border-deep-navy transition-colors outline-none" id="email" @bind-Value="_model.ContactEmail" type="email" placeholder="admin@institution.com" />
                    </div>
                </div>

                <!-- Phone -->
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray uppercase mb-2" for="phone">Institutional Phone</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">phone</span>
                        <InputText class="w-full bg-paper-white border border-surface-container-high rounded-DEFAULT pl-10 pr-4 py-3 font-body-md text-body-md text-on-background focus:ring-1 focus:ring-deep-navy focus:border-deep-navy transition-colors outline-none" id="phone" @bind-Value="_model.ContactPhone" type="tel" placeholder="+234 800 000 0000" />
                    </div>
                </div>

                <!-- Admin Full Name -->
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray uppercase mb-2" for="adminName">Your Full Name</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">person</span>
                        <InputText class="w-full bg-paper-white border border-surface-container-high rounded-DEFAULT pl-10 pr-4 py-3 font-body-md text-body-md text-on-background focus:ring-1 focus:ring-deep-navy focus:border-deep-navy transition-colors outline-none" id="adminName" @bind-Value="_model.AdminFullName" placeholder="Jane Doe" />
                    </div>
                </div>

                <!-- Admin Email -->
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray uppercase mb-2" for="adminEmail">Admin Email</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">mail</span>
                        <InputText class="w-full bg-paper-white border border-surface-container-high rounded-DEFAULT pl-10 pr-4 py-3 font-body-md text-body-md text-on-background focus:ring-1 focus:ring-deep-navy focus:border-deep-navy transition-colors outline-none" id="adminEmail" @bind-Value="_model.AdminEmail" type="email" placeholder="jane.doe@institution.com" />
                    </div>
                </div>

                <!-- Admin Phone -->
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray uppercase mb-2" for="adminPhone">Admin Phone</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">phone</span>
                        <InputText class="w-full bg-paper-white border border-surface-container-high rounded-DEFAULT pl-10 pr-4 py-3 font-body-md text-body-md text-on-background focus:ring-1 focus:ring-deep-navy focus:border-deep-navy transition-colors outline-none" id="adminPhone" @bind-Value="_model.AdminPhone" type="tel" placeholder="+234 800 000 0000" />
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <label class="block font-label-sm text-label-sm text-slate-gray uppercase mb-2" for="password">Secure Password</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">lock</span>
                        <InputText class="w-full bg-paper-white border border-surface-container-high rounded-DEFAULT pl-10 pr-4 py-3 font-body-md text-body-md text-on-background focus:ring-1 focus:ring-deep-navy focus:border-deep-navy transition-colors outline-none" id="password" @bind-Value="_model.Password" type="password" placeholder="••••••••" />
                    </div>
                    <p class="font-label-sm text-label-sm text-outline mt-1">Must contain uppercase, number, and symbol.</p>
                </div>

                <!-- Terms -->
                <div class="pt-2 pb-4">
                    <p class="font-body-sm text-body-sm text-slate-gray">
                        By submitting this request, you confirm authorization to act on behalf of the listed entity. Subject to <a class="text-deep-navy hover:underline font-medium" href="#">Compliance Terms</a>.
                    </p>
                </div>

                <button type="submit" disabled="@_isLoading"
                        class="w-full bg-deep-navy text-paper-white font-label-md text-label-md uppercase tracking-widest py-4 px-6 rounded-DEFAULT hover:bg-ink transition-colors flex items-center justify-center gap-2 group cursor-pointer disabled:opacity-50">
                    @if (_isLoading)
                    {
                        <span>Creating Account...</span>
                    }
                    else
                    {
                        <span>Continue to Step 2</span>
                        <span class="material-symbols-outlined text-paper-white group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    }
                </button>
            </EditForm>

            <div class="mt-8 text-center border-t border-surface-container-high pt-6">
                <p class="font-body-sm text-body-sm text-slate-gray">
                    Already have an account? <a class="text-deep-navy font-medium hover:underline" href="/login">Sign In</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterModel _model = new();
    private bool _isLoading;
    private string? _errorMessage;

    private async Task HandleSignup()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Api.PostAsync<RegisterResponse>("/v1/auth/register", _model);

            if (response is not null)
            {
                await TokenService.SetTokensAsync(response.AccessToken, response.RefreshToken, response.ExpiresAt);
                AuthState.NotifyAuthenticationStateChanged();
                Nav.NavigateTo("/onboarding/business");
            }
            else
            {
                _errorMessage = "Registration failed. Please try again.";
            }
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "An institution with this email already exists."
                : "Unable to connect. Please try again.";
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class RegisterModel
    {
        public string InstitutionName { get; set; } = string.Empty;
        public string ContactEmail { get; set; } = string.Empty;
        public string ContactPhone { get; set; } = string.Empty;
        public string AdminFullName { get; set; } = string.Empty;
        public string AdminEmail { get; set; } = string.Empty;
        public string AdminPhone { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
