@page "/onboarding/staff"
@layout OnboardingLayout

<PageTitle>TruvoID — Invite Core Team</PageTitle>

<style>
    .input-bespoke {
        border: 1px solid #c4c6d0;
        border-radius: 4px;
        transition: all 0.2s ease;
    }
    .input-bespoke:focus {
        outline: none;
        border-color: #1f3864;
        box-shadow: inset 0 0 0 1px #1f3864;
    }
</style>

<div class="bg-background text-on-surface font-body-md min-h-screen antialiased flex flex-col">

    <!-- Fixed Header -->
    <header class="w-full top-0 border-b border-surface-variant flex justify-between items-center px-margin-desktop h-20 bg-paper-white z-50 fixed">
        <div class="font-headline-md text-headline-md font-bold text-primary flex items-center gap-2">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">verified</span>
            TruvoID
        </div>
        <div class="text-on-surface-variant font-label-md text-label-md uppercase tracking-widest">
            Institutional Verification Setup
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center pt-24 pb-16 px-margin-mobile md:px-margin-desktop">
        <div class="w-full max-w-3xl bg-surface-container-lowest border border-surface-variant rounded shadow-sm p-8 md:p-12">

            <!-- Stepper -->
            <div class="mb-12">
                <div class="flex items-center justify-between relative">
                    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-px bg-surface-variant z-0"></div>
                    <div class="absolute left-0 top-1/2 -translate-y-1/2 h-[2px] bg-primary z-0" style="width: 85%;"></div>
                    @for (int i = 1; i <= 5; i++)
                    {
                        <div class="relative z-10 flex flex-col items-center gap-2">
                            <div class="w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-sm text-label-sm">
                                <span class="material-symbols-outlined text-[14px]">check</span>
                            </div>
                        </div>
                    }
                    <!-- Step 6 (current) -->
                    <div class="relative z-10 flex flex-col items-center gap-2" aria-label="Step 6 of 7">
                        <div class="w-6 h-6 rounded-full bg-surface-container-lowest border-2 border-primary text-primary flex items-center justify-center font-label-sm text-label-sm font-bold">6</div>
                        <span class="absolute top-8 font-label-sm text-label-sm text-primary whitespace-nowrap">Step 6 of 7: Staff</span>
                    </div>
                    <!-- Step 7 -->
                    <div class="relative z-10 flex flex-col items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-surface-container-lowest border border-outline text-outline flex items-center justify-center font-label-sm text-label-sm">7</div>
                    </div>
                </div>
            </div>

            <!-- Header -->
            <div class="mb-10 text-center md:text-left">
                <h1 class="font-headline-lg text-headline-lg text-on-surface mb-2">Invite Core Team</h1>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
                    Provision initial access for your administrative and compliance staff. This step is optional and can be completed later from the dashboard.
                </p>
            </div>

            <!-- Invitation Form -->
            <div class="space-y-6 mb-8" id="invitation-list">
                <div class="bg-surface-bright border border-surface-variant p-6 rounded relative group">
                    <button class="absolute top-4 right-4 text-outline hover:text-error transition-colors" type="button">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Full Name</label>
                            <input class="w-full input-bespoke px-3 py-2 font-body-sm text-body-sm bg-paper-white" placeholder="e.g. Jane Doe" type="text">
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Work Email</label>
                            <input class="w-full input-bespoke px-3 py-2 font-body-sm text-body-sm bg-paper-white" placeholder="jane.doe@institution.com" type="email">
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Role Assignment</label>
                            <select class="w-full input-bespoke px-3 py-2 font-body-sm text-body-sm bg-paper-white appearance-none cursor-pointer">
                                <option value="admin">Administrator</option>
                                <option value="compliance">Compliance Officer</option>
                                <option selected value="staff">Standard Staff</option>
                                <option value="auditor">External Auditor</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Daily Verification Limit</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-outline font-label-md text-label-md">#</span>
                                <input class="w-full input-bespoke pl-8 pr-3 py-2 font-label-md text-label-md bg-paper-white" min="0" type="number" value="50">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Add Another -->
            <div class="mb-12 border-b border-dashed border-surface-variant pb-8">
                <button class="flex items-center gap-2 text-primary hover:text-primary-fixed-variant transition-colors font-label-md text-label-md uppercase group" type="button">
                    <span class="material-symbols-outlined group-hover:scale-110 transition-transform">add_circle</span>
                    Add Another Staff Member
                </button>
            </div>

            <!-- Footer Actions -->
            <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-4">
                <button class="w-full md:w-auto font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-3 px-6 uppercase tracking-wider" type="button">
                    Skip for now
                </button>
                <div class="flex gap-4 w-full md:w-auto">
                    <a href="/onboarding/wallet" class="w-full md:w-auto bg-transparent border-[1.5px] border-deep-navy text-deep-navy font-label-md text-label-md py-3 px-8 rounded uppercase tracking-wider hover:bg-surface-container-low transition-colors">
                        Back
                    </a>
                    <a href="/onboarding/verify" class="w-full md:w-auto bg-deep-navy text-paper-white font-label-md text-label-md py-3 px-8 rounded uppercase tracking-wider hover:bg-primary transition-colors shadow-sm">
                        Continue
                    </a>
                </div>
            </div>
        </div>
    </main>
</div>
