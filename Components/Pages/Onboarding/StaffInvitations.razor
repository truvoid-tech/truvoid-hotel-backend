@page "/onboarding/staff"
@layout OnboardingLayout
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>TruvoID — Invite Core Team</PageTitle>

<style>
    .input-bespoke {
        border: 1px solid #c4c6d0;
        border-radius: 4px;
        transition: all 0.2s ease;
    }
    .input-bespoke:focus {
        outline: none;
        border-color: #1f3864;
        box-shadow: inset 0 0 0 1px #1f3864;
    }
</style>

<div class="bg-background text-on-surface font-body-md min-h-screen antialiased flex flex-col">

    <!-- Fixed Header -->
    <header class="w-full top-0 border-b border-surface-variant flex justify-between items-center px-margin-desktop h-20 bg-paper-white z-50 fixed">
        <div class="font-headline-md text-headline-md font-bold text-primary flex items-center gap-2">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">verified</span>
            TruvoID
        </div>
        <div class="text-on-surface-variant font-label-md text-label-md uppercase tracking-widest">
            Institutional Verification Setup
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center pt-24 pb-16 px-margin-mobile md:px-margin-desktop">
        <div class="w-full max-w-3xl bg-surface-container-lowest border border-surface-variant rounded shadow-sm p-8 md:p-12">

            <!-- Header -->
            <div class="mb-10 text-center md:text-left">
                <h1 class="font-headline-lg text-headline-lg text-on-surface mb-2">Invite Core Team</h1>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
                    Provision initial access for your administrative and compliance staff. This step is optional and can be completed later from the dashboard.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded text-red-700 font-body-sm text-body-sm">@_errorMessage</div>
            }

            <!-- Invitation Forms -->
            @foreach (var invite in _invites)
            {
                <div class="bg-surface-bright border border-surface-variant p-6 rounded relative group mb-6">
                    <button class="absolute top-4 right-4 text-outline hover:text-error transition-colors" type="button" @onclick="() => RemoveInvite(invite)">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Full Name</label>
                            <input class="w-full input-bespoke px-3 py-2 font-body-sm text-body-sm bg-paper-white" placeholder="e.g. Jane Doe" @bind="invite.FullName" type="text">
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Work Email</label>
                            <input class="w-full input-bespoke px-3 py-2 font-body-sm text-body-sm bg-paper-white" placeholder="jane.doe@institution.com" @bind="invite.Email" type="email">
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Role Assignment</label>
                            <select class="w-full input-bespoke px-3 py-2 font-body-sm text-body-sm bg-paper-white appearance-none cursor-pointer" @bind="invite.Role">
                                <option value="1">Administrator</option>
                                <option value="0" selected>Standard Staff</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Daily Verification Limit</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-outline font-label-md text-label-md">#</span>
                                <input class="w-full input-bespoke pl-8 pr-3 py-2 font-label-md text-label-md bg-paper-white" min="0" type="number" @bind="invite.DailyCallLimit">
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Add Another -->
            <div class="mb-12 border-b border-dashed border-surface-variant pb-8">
                <button class="flex items-center gap-2 text-primary hover:text-primary-fixed-variant transition-colors font-label-md text-label-md uppercase group" type="button" @onclick="AddInvite">
                    <span class="material-symbols-outlined group-hover:scale-110 transition-transform">add_circle</span>
                    Add Another Staff Member
                </button>
            </div>

            <!-- Footer Actions -->
            <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-4">
                <button class="w-full md:w-auto font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-3 px-6 uppercase tracking-wider" @onclick="Skip">
                    Skip for now
                </button>
                <div class="flex gap-4 w-full md:w-auto">
                    <a href="/onboarding/wallet" class="w-full md:w-auto bg-transparent border-[1.5px] border-deep-navy text-deep-navy font-label-md text-label-md py-3 px-8 rounded uppercase tracking-wider hover:bg-surface-container-low transition-colors text-center">
                        Back
                    </a>
                    <button @onclick="HandleInvite" disabled="@_isLoading" class="w-full md:w-auto bg-deep-navy text-paper-white font-label-md text-label-md py-3 px-8 rounded uppercase tracking-wider hover:bg-primary transition-colors shadow-sm disabled:opacity-50">
                        @(_isLoading ? "Inviting..." : "Continue")
                    </button>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    private List<InviteModel> _invites = new() { new() { DailyCallLimit = 50 } };
    private bool _isLoading;
    private string? _errorMessage;

    private void AddInvite() => _invites.Add(new() { DailyCallLimit = 50 });
    private void RemoveInvite(InviteModel invite) => _invites.Remove(invite);
    private void Skip() => Nav.NavigateTo("/onboarding/verify");

    private async Task HandleInvite()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            foreach (var invite in _invites.Where(i => !string.IsNullOrWhiteSpace(i.Email)))
            {
                await Api.PostRawAsync("/v1/onboarding/staff", new
                {
                    fullName = invite.FullName,
                    email = invite.Email,
                    role = int.Parse(invite.Role),
                    dailyCallLimit = invite.DailyCallLimit
                });
            }

            Nav.NavigateTo("/onboarding/verify");
        }
        catch (Exception)
        {
            _errorMessage = "Some invitations failed. You can retry from the dashboard.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class InviteModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = "0";
        public int DailyCallLimit { get; set; } = 50;
    }
}
