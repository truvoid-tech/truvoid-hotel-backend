@page "/settings"
@rendermode InteractiveServer
@layout DashboardLayout
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>TruvoID — Settings</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex-1">

    <!-- Page Header -->
    <div class="mb-12">
        <h2 class="font-display-lg text-display-lg text-deep-navy mb-2">Settings</h2>
        <p class="font-body-lg text-body-lg text-slate-gray max-w-2xl">Manage your institution profile, notification preferences, and security settings.</p>
    </div>

    <!-- Tabs -->
    <div class="flex border-b border-outline-variant mb-8">
        <button @onclick='() => _activeTab = "profile"'
                class="@TabClass("profile")">
            <span class="material-symbols-outlined text-[16px] mr-2 align-middle">business</span>
            Institution Profile
        </button>
        <button @onclick='() => _activeTab = "notifications"'
                class="@TabClass("notifications")">
            <span class="material-symbols-outlined text-[16px] mr-2 align-middle">notifications</span>
            Notifications
        </button>
        <button @onclick='() => _activeTab = "security"'
                class="@TabClass("security")">
            <span class="material-symbols-outlined text-[16px] mr-2 align-middle">lock</span>
            Security
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_saveMessage))
    {
        <div class="bg-[#e6f4ea] border border-[#ceead6] rounded-lg p-4 mb-6 flex items-center gap-3">
            <span class="material-symbols-outlined text-[#137333]">check_circle</span>
            <p class="text-[#137333] font-body-sm text-body-sm">@_saveMessage</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-error-container/30 border border-error/20 rounded-lg p-4 mb-6 flex items-center gap-3">
            <span class="material-symbols-outlined text-error">error</span>
            <p class="text-on-error-container font-body-sm text-body-sm">@_errorMessage</p>
        </div>
    }

    <!-- ═══════════════ INSTITUTION PROFILE TAB ═══════════════ -->
    @if (_activeTab == "profile")
    {
        <div class="bg-paper-white border border-outline-variant rounded-xl overflow-hidden">
            <div class="p-6 md:p-8 border-b border-outline-variant">
                <h3 class="font-headline-md text-headline-md text-deep-navy">Institution Details</h3>
                <p class="font-body-sm text-body-sm text-slate-gray mt-1">Basic information about your organization.</p>
            </div>

            <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Institution Name</label>
                    <input @bind="_institutionName"
                           class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none"
                           placeholder="e.g. Heritage Hotels Ltd" />
                </div>
                <div>
                    <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Institution Type</label>
                    <select @bind="_institutionType"
                            class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none appearance-none bg-surface-container-lowest">
                        <option value="Hotel">Hotel / Hospitality</option>
                        <option value="Bank">Bank / Financial</option>
                        <option value="HR">HR / Recruitment</option>
                        <option value="Fintech">Fintech</option>
                        <option value="RealEstate">Real Estate / Landlord</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div>
                    <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Contact Email</label>
                    <input @bind="_contactEmail" type="email"
                           class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none"
                           placeholder="admin@institution.com" />
                </div>
                <div>
                    <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Contact Phone</label>
                    <input @bind="_contactPhone"
                           class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none"
                           placeholder="+234 801 234 5678" />
                </div>
                <div class="md:col-span-2">
                    <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Business Address</label>
                    <input @bind="_address"
                           class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none"
                           placeholder="Full registered business address" />
                </div>
            </div>

            <div class="px-6 md:px-8 py-4 border-t border-outline-variant bg-surface-container-low flex justify-end">
                <button @onclick="SaveProfile" disabled="@_saving"
                        class="bg-deep-navy text-paper-white font-label-md text-label-md uppercase py-2.5 px-6 rounded hover:opacity-90 transition-opacity disabled:opacity-50 flex items-center gap-2">
                    @if (_saving)
                    {
                        <div class="w-4 h-4 border-2 border-paper-white border-t-transparent rounded-full animate-spin"></div>
                    }
                    Save Changes
                </button>
            </div>
        </div>
    }

    <!-- ═══════════════ NOTIFICATIONS TAB ═══════════════ -->
    @if (_activeTab == "notifications")
    {
        <div class="space-y-6">
            <!-- Low Balance Alerts -->
            <div class="bg-paper-white border border-outline-variant rounded-xl overflow-hidden">
                <div class="p-6 md:p-8 border-b border-outline-variant">
                    <h3 class="font-headline-md text-headline-md text-deep-navy">Low Balance Alerts</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray mt-1">Configure when you receive balance notifications.</p>
                </div>
                <div class="p-6 md:p-8 space-y-6">
                    <div>
                        <label class="block font-label-sm text-label-sm text-deep-navy mb-2 uppercase">Alert Threshold (₦)</label>
                        <div class="relative max-w-sm">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-gray">₦</span>
                            <input @bind="_alertThreshold"
                                   class="w-full pl-8 pr-4 py-3 border border-outline-variant rounded-lg font-body-sm text-body-sm focus:border-deep-navy outline-none"
                                   placeholder="10000" />
                        </div>
                        <p class="font-body-sm text-[12px] text-slate-gray mt-1">You'll be notified when your balance drops below this amount.</p>
                    </div>

                    <div class="flex items-center justify-between p-4 border border-outline-variant rounded-lg hover:bg-surface-container-low transition-colors">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-slate-gray">mail</span>
                            <div>
                                <p class="font-body-sm text-body-sm text-deep-navy font-medium">Email Alerts</p>
                                <p class="font-body-sm text-[12px] text-slate-gray">Receive low-balance alerts via email</p>
                            </div>
                        </div>
                        <button @onclick="() => _emailAlerts = !_emailAlerts"
                                class="@ToggleClass(_emailAlerts)">
                            <span class="@(ToggleKnobClass(_emailAlerts)) inline-block h-4 w-4 transform bg-paper-white rounded-full transition-transform shadow-sm"></span>
                        </button>
                    </div>

                    <div class="flex items-center justify-between p-4 border border-outline-variant rounded-lg hover:bg-surface-container-low transition-colors">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-slate-gray">sms</span>
                            <div>
                                <p class="font-body-sm text-body-sm text-deep-navy font-medium">SMS Alerts</p>
                                <p class="font-body-sm text-[12px] text-slate-gray">Receive low-balance alerts via SMS</p>
                            </div>
                        </div>
                        <button @onclick="() => _smsAlerts = !_smsAlerts"
                                class="@ToggleClass(_smsAlerts)">
                            <span class="@(ToggleKnobClass(_smsAlerts)) inline-block h-4 w-4 transform bg-paper-white rounded-full transition-transform shadow-sm"></span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Verification Result Notifications -->
            <div class="bg-paper-white border border-outline-variant rounded-xl overflow-hidden">
                <div class="p-6 md:p-8 border-b border-outline-variant">
                    <h3 class="font-headline-md text-headline-md text-deep-navy">Verification Results</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray mt-1">Control how verification results are delivered to your team.</p>
                </div>
                <div class="p-6 md:p-8 space-y-4">
                    <div class="flex items-center justify-between p-4 border border-outline-variant rounded-lg hover:bg-surface-container-low transition-colors">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-slate-gray">email</span>
                            <div>
                                <p class="font-body-sm text-body-sm text-deep-navy font-medium">Email on Verification Complete</p>
                                <p class="font-body-sm text-[12px] text-slate-gray">Send result summary to admin email after each lookup</p>
                            </div>
                        </div>
                        <button @onclick="() => _verifyEmailResults = !_verifyEmailResults"
                                class="@ToggleClass(_verifyEmailResults)">
                            <span class="@(ToggleKnobClass(_verifyEmailResults)) inline-block h-4 w-4 transform bg-paper-white rounded-full transition-transform shadow-sm"></span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="flex justify-end">
                <button @onclick="SaveNotifications" disabled="@_saving"
                        class="bg-deep-navy text-paper-white font-label-md text-label-md uppercase py-2.5 px-6 rounded hover:opacity-90 transition-opacity disabled:opacity-50">
                    Save Preferences
                </button>
            </div>
        </div>
    }

    <!-- ═══════════════ SECURITY TAB ═══════════════ -->
    @if (_activeTab == "security")
    {
        <div class="space-y-6">
            <!-- Change Password -->
            <div class="bg-paper-white border border-outline-variant rounded-xl overflow-hidden">
                <div class="p-6 md:p-8 border-b border-outline-variant">
                    <h3 class="font-headline-md text-headline-md text-deep-navy">Change Password</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray mt-1">Update your account password. Use 8+ characters with uppercase, number, and symbol.</p>
                </div>
                <div class="p-6 md:p-8 flex flex-col gap-4 max-w-md">
                    <div>
                        <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Current Password</label>
                        <input @bind="_currentPassword" type="password"
                               class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none" />
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">New Password</label>
                        <input @bind="_newPassword" type="password"
                               class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none" />
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Confirm New Password</label>
                        <input @bind="_confirmPassword" type="password"
                               class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none" />
                    </div>

                    @if (!string.IsNullOrEmpty(_passwordError))
                    {
                        <div class="bg-error-container/30 border border-error/20 rounded-lg p-3 flex items-center gap-2">
                            <span class="material-symbols-outlined text-error text-[16px]">error</span>
                            <p class="text-on-error-container text-body-sm text-[13px]">@_passwordError</p>
                        </div>
                    }

                    <button @onclick="ChangePassword" disabled="@_changingPassword"
                            class="bg-deep-navy text-paper-white font-label-md text-label-md uppercase py-2.5 px-6 rounded hover:opacity-90 transition-opacity disabled:opacity-50 self-start mt-2 flex items-center gap-2">
                        @if (_changingPassword)
                        {
                            <div class="w-4 h-4 border-2 border-paper-white border-t-transparent rounded-full animate-spin"></div>
                        }
                        Update Password
                    </button>
                </div>
            </div>

            <!-- Danger Zone -->
            <div class="bg-paper-white border border-error/30 rounded-xl overflow-hidden">
                <div class="p-6 md:p-8 border-b border-error/20">
                    <h3 class="font-headline-md text-headline-md text-error">Danger Zone</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray mt-1">Irreversible actions that affect your institution.</p>
                </div>
                <div class="p-6 md:p-8 flex items-center justify-between">
                    <div>
                        <p class="font-body-sm text-body-sm text-on-surface font-medium">Deactivate Account</p>
                        <p class="font-body-sm text-[12px] text-slate-gray">This will disable all verification operations and API access.</p>
                    </div>
                    <button class="border border-error text-error font-label-sm text-label-sm uppercase py-2 px-4 rounded hover:bg-error-container/30 transition-colors">
                        Deactivate
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _activeTab = "profile";
    private bool _saving = false;
    private string? _saveMessage;
    private string? _errorMessage;

    // Profile
    private string _institutionName = string.Empty;
    private string _institutionType = "Hotel";
    private string _contactEmail = string.Empty;
    private string _contactPhone = string.Empty;
    private string _address = string.Empty;

    // Notifications
    private decimal _alertThreshold = 10000;
    private bool _emailAlerts = true;
    private bool _smsAlerts = false;
    private bool _verifyEmailResults = false;

    // Security
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;
    private bool _changingPassword = false;

    private string TabClass(string tab) => _activeTab == tab
        ? "px-8 py-4 font-label-md text-label-md uppercase tracking-wider border-b-2 border-warm-gold text-deep-navy"
        : "px-8 py-4 font-label-md text-label-md uppercase tracking-wider border-b-2 border-transparent text-slate-gray hover:text-deep-navy hover:bg-surface-container-low";

    private string ToggleClass(bool on) => on
        ? "bg-warm-gold relative inline-flex h-6 w-11 items-center rounded-full transition-colors"
        : "bg-surface-variant relative inline-flex h-6 w-11 items-center rounded-full transition-colors";

    private string ToggleKnobClass(bool on) => on
        ? "translate-x-6"
        : "translate-x-1";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await Api.GetAsync<OnboardingStatusResponse>("v1/onboarding/status");
            if (status?.Institution is not null)
            {
                _institutionName = status.Institution.Name;
            }
        }
        catch
        {
            // Use defaults if API not available
        }
    }

    private async Task SaveProfile()
    {
        _saving = true;
        _saveMessage = null;
        _errorMessage = null;
        try
        {
            await Api.PutAsync("v1/onboarding/institution", new InstitutionSetupRequest
            {
                Name = _institutionName,
                ContactEmail = _contactEmail,
                ContactPhone = _contactPhone
            });
            _saveMessage = "Institution profile updated successfully.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveNotifications()
    {
        _saving = true;
        _saveMessage = null;
        _errorMessage = null;
        try
        {
            await Task.Delay(300);
            _saveMessage = "Notification preferences saved.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ChangePassword()
    {
        _passwordError = null;
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _passwordError = "Please fill in all password fields.";
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _passwordError = "New passwords do not match.";
            return;
        }
        if (_newPassword.Length < 8)
        {
            _passwordError = "Password must be at least 8 characters.";
            return;
        }

        _changingPassword = true;
        try
        {
            await Api.PostAsync("v1/auth/change-password", new
            {
                currentPassword = _currentPassword,
                newPassword = _newPassword
            });
            _saveMessage = "Password changed successfully.";
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
        }
        catch (Exception ex)
        {
            _passwordError = ex.Message;
        }
        finally
        {
            _changingPassword = false;
        }
    }
}
