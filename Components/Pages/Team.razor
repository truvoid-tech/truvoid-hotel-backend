@page "/team"
@rendermode InteractiveServer
@layout DashboardLayout
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>TruvoID — Team</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex-1">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
        <div>
            <h2 class="font-display-lg text-display-lg text-deep-navy mb-2">Team</h2>
            <p class="font-body-lg text-body-lg text-slate-gray max-w-2xl">Manage staff members, roles, and per-staff daily verification limits.</p>
        </div>
        <button @onclick="() => _showInviteModal = true"
                class="flex items-center gap-2 bg-warm-gold text-paper-white font-label-md text-label-md uppercase py-3 px-6 rounded hover:opacity-90 transition-opacity">
            <span class="material-symbols-outlined text-[18px]">person_add</span>
            Invite Staff
        </button>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-gutter mb-12">
        <div class="bg-paper-white border border-outline-variant rounded p-6">
            <div class="flex items-center justify-between mb-2">
                <span class="font-label-sm text-label-sm text-slate-gray uppercase">Total Members</span>
                <span class="material-symbols-outlined text-deep-navy text-[20px]">group</span>
            </div>
            <p class="font-display-lg text-display-lg text-primary font-bold">@(_staff?.Count ?? 0)</p>
        </div>
        <div class="bg-paper-white border border-outline-variant rounded p-6">
            <div class="flex items-center justify-between mb-2">
                <span class="font-label-sm text-label-sm text-slate-gray uppercase">Admins</span>
                <span class="material-symbols-outlined text-deep-navy text-[20px]">admin_panel_settings</span>
            </div>
            <p class="font-display-lg text-display-lg text-primary font-bold">@(_staff?.Count(s => s.Role == UserRole.Admin) ?? 0)</p>
        </div>
        <div class="bg-paper-white border border-outline-variant rounded p-6">
            <div class="flex items-center justify-between mb-2">
                <span class="font-label-sm text-label-sm text-slate-gray uppercase">Pending Invites</span>
                <span class="material-symbols-outlined text-deep-navy text-[20px]">mail</span>
            </div>
            <p class="font-display-lg text-display-lg text-warm-gold font-bold">@(_staff?.Count(s => s.Status == UserStatus.PendingInvitation) ?? 0)</p>
        </div>
    </div>

    <!-- Staff Table -->
    <div class="bg-paper-white border border-outline-variant rounded overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-outline-variant flex items-center justify-between">
            <h3 class="font-headline-md text-headline-md text-deep-navy">Staff Members</h3>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-gray text-[18px]">search</span>
                <input @bind="_searchQuery" @bind:event="oninput"
                       class="bg-surface-container-low border border-outline-variant rounded-lg pl-10 pr-4 py-2 font-body-sm text-body-sm focus:border-deep-navy outline-none w-64"
                       placeholder="Search staff..." />
            </div>
        </div>

        @if (_loading)
        {
            <div class="flex items-center justify-center py-16">
                <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
            </div>
        }
        else if (_staff is null || !_staff.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 gap-4">
                <span class="material-symbols-outlined text-outline text-[48px]">group_off</span>
                <p class="font-body-md text-body-md text-slate-gray">No staff members yet.</p>
                <button @onclick="() => _showInviteModal = true"
                        class="bg-warm-gold text-paper-white font-label-md text-label-md uppercase py-2 px-4 rounded hover:opacity-90 transition-opacity">
                    Invite First Staff Member
                </button>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full min-w-[700px]">
                    <thead class="bg-surface-container-low border-b border-outline-variant">
                        <tr>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Member</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Role</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Status</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Daily Limit</th>
                            <th class="text-right px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in FilteredStaff)
                        {
                            <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-deep-navy flex items-center justify-center">
                                            <span class="font-label-md text-label-md text-paper-white">@(GetInitials(member.FullName))</span>
                                        </div>
                                        <div>
                                            <p class="font-body-sm text-body-sm text-on-surface font-medium">@member.FullName</p>
                                            <p class="font-body-sm text-[12px] text-slate-gray">@member.Email</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (member.Role == UserRole.Admin)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-deep-navy text-paper-white font-label-sm text-label-sm uppercase">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-surface-container-low text-on-surface border border-outline-variant font-label-sm text-label-sm uppercase">Staff</span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    @if (member.Status == UserStatus.Active)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#e6f4ea] text-[#137333] font-label-sm text-label-sm uppercase">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#137333]"></span>
                                            Active
                                        </span>
                                    }
                                    else if (member.Status == UserStatus.PendingInvitation)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#fef7e0] text-[#b06000] font-label-sm text-label-sm uppercase">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#b06000]"></span>
                                            Invited
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-surface-variant text-on-surface-variant font-label-sm text-label-sm uppercase">
                                            @member.Status
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <span class="font-label-md text-label-md text-deep-navy">50 calls</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button @onclick="() => ConfirmRemove(member)"
                                                class="p-2 rounded hover:bg-error-container/30 transition-colors text-slate-gray hover:text-error"
                                                title="Remove member">
                                            <span class="material-symbols-outlined text-[18px]">person_remove</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Invite Staff Modal -->
@if (_showInviteModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" @onclick="() => _showInviteModal = false">
        <div class="absolute inset-0 bg-ink/40"></div>
        <div class="relative bg-paper-white rounded-xl shadow-xl w-full max-w-lg border border-outline-variant p-8" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between mb-6">
                <h3 class="font-headline-md text-headline-md text-deep-navy">Invite Staff Member</h3>
                <button @onclick="() => _showInviteModal = false" class="text-slate-gray hover:text-deep-navy">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_inviteError))
            {
                <div class="bg-error-container/30 border border-error/20 rounded-lg p-4 mb-4 flex items-start gap-3">
                    <span class="material-symbols-outlined text-error mt-0.5">error</span>
                    <p class="text-on-error-container text-body-sm">@_inviteError</p>
                </div>
            }

            <EditForm Model="_inviteModel" OnValidSubmit="HandleInvite" class="flex flex-col gap-4">
                <div>
                    <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Full Name</label>
                    <input @bind="_inviteModel.FullName" class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none" placeholder="e.g. Adebayo Cole" />
                </div>
                <div>
                    <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Email Address</label>
                    <input @bind="_inviteModel.Email" type="email" class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none" placeholder="staff@institution.com" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Role</label>
                        <select @bind="_inviteModel.Role" class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none appearance-none bg-surface-container-lowest">
                            <option value="Staff">Staff</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-deep-navy mb-1.5 uppercase">Daily Call Limit</label>
                        <input @bind="_inviteModel.DailyCallLimit" type="number" min="1" class="w-full border border-outline-variant rounded-lg px-4 py-3 font-body-sm text-body-sm focus:border-deep-navy outline-none" placeholder="50" />
                    </div>
                </div>

                <div class="flex gap-3 mt-4">
                    <button type="button" @onclick="() => _showInviteModal = false"
                            class="flex-1 border border-deep-navy text-deep-navy font-label-md text-label-md uppercase py-3 rounded hover:bg-surface-container-low transition-colors">
                        Cancel
                    </button>
                    <button type="submit" disabled="@_inviting"
                            class="flex-1 bg-warm-gold text-paper-white font-label-md text-label-md uppercase py-3 rounded hover:opacity-90 transition-opacity disabled:opacity-50 flex items-center justify-center gap-2">
                        @if (_inviting)
                        {
                            <div class="w-4 h-4 border-2 border-paper-white border-t-transparent rounded-full animate-spin"></div>
                        }
                        <span>Send Invite</span>
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Confirm Remove Modal -->
@if (_showRemoveModal && _removingMember is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" @onclick="() => _showRemoveModal = false">
        <div class="absolute inset-0 bg-ink/40"></div>
        <div class="relative bg-paper-white rounded-xl shadow-xl w-full max-w-md border border-outline-variant p-8" @onclick:stopPropagation="true">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-full bg-error-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-error">person_remove</span>
                </div>
                <div>
                    <h3 class="font-headline-md text-headline-md text-deep-navy">Remove Staff Member</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray">This action cannot be undone.</p>
                </div>
            </div>

            <div class="bg-surface-container-low rounded-lg p-4 mb-6">
                <p class="font-body-sm text-body-sm text-on-surface"><strong>@_removingMember.FullName</strong></p>
                <p class="font-body-sm text-[12px] text-slate-gray">@_removingMember.Email</p>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase mt-1">@_removingMember.Role</p>
            </div>

            <div class="flex gap-3">
                <button @onclick="() => _showRemoveModal = false"
                        class="flex-1 border border-deep-navy text-deep-navy font-label-md text-label-md uppercase py-3 rounded hover:bg-surface-container-low transition-colors">
                    Keep Member
                </button>
                <button @onclick="RemoveStaff"
                        class="flex-1 bg-error text-paper-white font-label-md text-label-md uppercase py-3 rounded hover:opacity-90 transition-opacity">
                    Remove
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<StaffInviteResponse>? _staff;
    private bool _loading = true;
    private string _searchQuery = string.Empty;

    // Invite modal
    private bool _showInviteModal = false;
    private bool _inviting = false;
    private string? _inviteError;
    private InviteFormModel _inviteModel = new();

    // Remove modal
    private bool _showRemoveModal = false;
    private StaffInviteResponse? _removingMember;

    private IEnumerable<StaffInviteResponse> FilteredStaff => _staff?
        .Where(s => string.IsNullOrEmpty(_searchQuery)
            || s.FullName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
            || s.Email.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<StaffInviteResponse>();

    protected override async Task OnInitializedAsync()
    {
        await LoadStaff();
    }

    private async Task LoadStaff()
    {
        _loading = true;
        try
        {
            _staff = await Api.GetAsync<List<StaffInviteResponse>>("v1/onboarding/staff");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load staff: {ex.Message}");
            _staff = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }

    private async Task HandleInvite()
    {
        _inviteError = null;
        _inviting = true;
        try
        {
            var role = Enum.Parse<UserRole>(_inviteModel.Role);
            var request = new StaffInviteRequest
            {
                FullName = _inviteModel.FullName,
                Email = _inviteModel.Email,
                Role = role,
                DailyCallLimit = _inviteModel.DailyCallLimit
            };

            await Api.PostAsync<StaffInviteResponse>("v1/onboarding/staff", request);
            _showInviteModal = false;
            _inviteModel = new();
            await LoadStaff();
        }
        catch (HttpRequestException ex)
        {
            _inviteError = $"Failed to send invite: {ex.Message}";
        }
        catch (Exception ex)
        {
            _inviteError = ex.Message;
        }
        finally
        {
            _inviting = false;
        }
    }

    private void ConfirmRemove(StaffInviteResponse member)
    {
        _removingMember = member;
        _showRemoveModal = true;
    }

    private async Task RemoveStaff()
    {
        if (_removingMember is null) return;
        try
        {
            await Api.DeleteAsync($"v1/onboarding/staff/{_removingMember.UserId}");
            _showRemoveModal = false;
            _removingMember = null;
            await LoadStaff();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to remove staff: {ex.Message}");
        }
    }

    public class InviteFormModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = "Staff";
        public int DailyCallLimit { get; set; } = 50;
    }
}
