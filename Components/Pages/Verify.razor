@page "/verify"
@rendermode InteractiveServer
@inject IVerificationService VerificationService

<PageTitle>Verify — TruvoID</PageTitle>

<div class="container mt-4">
    <h2>Identity Verification</h2>
    <p>Submit a NIN, BVN, or phone number for verification.</p>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Verification Type</label>
                        <select class="form-select" @bind="_selectedType">
                            <option value="0">NIN</option>
                            <option value="1">BVN</option>
                            <option value="2">Phone Number</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Subject Identifier</label>
                        <input type="text" class="form-control" @bind="_subjectRef"
                               placeholder="@(_selectedType == "2" ? "08012345678" : "Enter 11-digit number")" />
                    </div>
                    <button class="btn btn-primary" @onclick="SubmitVerification" disabled="@_isLoading">
                        @(_isLoading ? "Verifying..." : "Run Verification")
                    </button>
                </div>
            </div>
        </div>

        @if (_result is not null)
        {
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        Result
                    </div>
                    <div class="card-body">
                        <p><strong>Status:</strong> <span class="badge @(_result.Status == "match" ? "bg-success" : _result.Status == "no_match" ? "bg-warning" : "bg-danger")">@_result.Status</span></p>
                        <p><strong>Call ID:</strong> @_result.CallId</p>
                        <p><strong>Balance After:</strong> ₦@_result.WalletBalanceAfter.ToString("N2")</p>
                        @if (_result.Data is not null)
                        {
                            <hr />
                            <p><strong>Name:</strong> @_result.Data.Name</p>
                            <p><strong>DOB:</strong> @_result.Data.DateOfBirth</p>
                        }
                        @if (!string.IsNullOrEmpty(_result.ErrorMessage))
                        {
                            <div class="alert alert-danger mt-2">@_result.ErrorMessage</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _selectedType = "0";
    private string _subjectRef = string.Empty;
    private bool _isLoading;
    private VerificationResponse? _result;
    private Guid _institutionId = Guid.Empty;

    private async Task SubmitVerification()
    {
        if (string.IsNullOrWhiteSpace(_subjectRef)) return;

        _isLoading = true;
        var type = Enum.Parse<VerificationType>(_selectedType);
        _result = await VerificationService.VerifyAsync(_institutionId, type, _subjectRef);
        _isLoading = false;
    }
}
