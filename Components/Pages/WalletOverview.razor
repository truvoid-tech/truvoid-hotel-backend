@page "/wallet"
@layout DashboardLayout
@rendermode InteractiveServer
@inject ApiClient Api

<PageTitle>Wallet — TruvoID</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex-1 flex flex-col gap-section-gap max-w-[1440px] mx-auto w-full">

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">

        <!-- Main Balance Card -->
        <div class="lg:col-span-8 bg-surface-container-lowest border border-surface-variant rounded-xl p-8 relative overflow-hidden flex flex-col justify-between min-h-[300px] shadow-[0_12px_32px_-4px_rgba(31,56,100,0.05)] border-t-warm-gold border-t-[3px]">
            <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4 pointer-events-none"></div>
            <div>
                <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest mb-4">Current Balance</p>
                <h3 class="font-display-lg text-display-lg text-deep-navy font-bold">₦@(_balance?.Balance.ToString("N2") ?? "0.00")</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-2 flex items-center gap-2">
                    <span class="material-symbols-outlined text-warm-gold" style="font-size: 16px;">verified</span>
                    Available for immediate verification operations
                </p>
            </div>
            <div class="flex flex-wrap gap-4 mt-8">
                <a href="/wallet/topup" class="bg-warm-gold text-on-primary font-label-md text-label-md uppercase px-6 py-3 rounded shadow-sm hover:opacity-90 transition-opacity flex items-center gap-2">
                    <span class="material-symbols-outlined">add</span>
                    Replenish Balance
                </a>
                <a href="/wallet/alerts" class="bg-transparent border-[1.5px] border-deep-navy text-deep-navy font-label-md text-label-md uppercase px-6 py-3 rounded hover:bg-deep-navy/5 transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined">notifications_active</span>
                    Set Alert
                </a>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="lg:col-span-4 flex flex-col gap-gutter">
            <div class="bg-surface-container-lowest border border-surface-variant rounded-xl p-6 shadow-[0_12px_32px_-4px_rgba(31,56,100,0.05)]">
                <p class="font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">This Month</p>
                <div class="flex justify-between items-end mb-2">
                    <span class="font-headline-md text-headline-md text-deep-navy">₦@(_monthlySpend.ToString("N2"))</span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant mb-1">spent</span>
                </div>
                <div class="w-full bg-surface-variant h-1.5 rounded-full overflow-hidden">
                    <div class="bg-primary h-full rounded-full" style="width: @(_monthlyPercent)%"></div>
                </div>
            </div>

            <div class="bg-surface-container-lowest border border-surface-variant rounded-xl p-6 shadow-[0_12px_32px_-4px_rgba(31,56,100,0.05)] flex-1 flex flex-col justify-center">
                <div class="flex items-start gap-4">
                    <div class="bg-primary-fixed p-3 rounded-lg">
                        <span class="material-symbols-outlined text-primary">receipt_long</span>
                    </div>
                    <div>
                        <h4 class="font-body-lg text-body-lg text-deep-navy font-semibold">Pricing</h4>
                        <div class="space-y-1 mt-2">
                            <p class="font-body-sm text-body-sm text-on-surface-variant">NIN: ₦100/lookup</p>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">BVN: ₦150/lookup</p>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">Phone: ₦50/lookup</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Table -->
    <div>
        <div class="flex justify-between items-center mb-6">
            <h3 class="font-headline-md text-headline-md text-deep-navy font-bold">Recent Activity</h3>
            <a href="/history" class="font-label-sm text-label-sm text-primary uppercase border border-primary px-4 py-2 rounded hover:bg-primary/5 transition-colors">View All</a>
        </div>

        <div class="bg-surface-container-lowest border border-surface-variant rounded-xl shadow-[0_12px_32px_-4px_rgba(31,56,100,0.05)] overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-deep-navy text-on-primary font-label-sm text-label-sm uppercase tracking-[0.05em]">
                            <th class="px-6 py-4 font-medium">Date</th>
                            <th class="px-6 py-4 font-medium">Transaction ID</th>
                            <th class="px-6 py-4 font-medium">Type</th>
                            <th class="px-6 py-4 font-medium">Status</th>
                            <th class="px-6 py-4 font-medium text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-variant text-body-sm">
                        @if (_recentTransactions?.Any() == true)
                        {
                            @foreach (var tx in _recentTransactions.Take(5))
                            {
                                <tr class="hover:bg-surface-variant/30 transition-colors">
                                    <td class="px-6 py-4 text-on-surface-variant">@tx.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="px-6 py-4 font-label-sm text-label-sm text-deep-navy">@(tx.ReferenceId?.Length > 12 ? tx.ReferenceId[..12] : tx.Id.ToString()[..8])</td>
                                    <td class="px-6 py-4">@(tx.Type == WalletTransactionType.Credit ? "Top-up" : tx.Type == WalletTransactionType.Debit ? "Verification Fees" : "Refund")</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center px-2 py-1 rounded bg-surface-variant text-deep-navy font-label-sm text-[10px] uppercase border border-outline-variant">
                                            @(tx.Type == WalletTransactionType.Credit ? "Completed" : tx.Type == WalletTransactionType.Debit ? "Deducted" : "Reversed")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-right font-medium @(tx.Type == WalletTransactionType.Credit ? "text-deep-navy" : "text-on-surface-variant")">
                                        @(tx.Type == WalletTransactionType.Credit ? "+" : "-") ₦@tx.Amount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center">
                                    <span class="material-symbols-outlined text-outline-variant text-[40px] mb-2 block">receipt_long</span>
                                    <p class="font-body-sm text-body-sm text-slate-gray">No transactions yet. Top up to get started.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private WalletBalanceResponse? _balance;
    private List<WalletTransactionResponse>? _recentTransactions;
    private decimal _monthlySpend;
    private int _monthlyPercent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _balance = await Api.GetAsync<WalletBalanceResponse>("/v1/wallet/balance");
            _recentTransactions = await Api.GetAsync<List<WalletTransactionResponse>>("/v1/wallet/transactions?page=1&pageSize=10");

            if (_recentTransactions is not null)
            {
                var now = DateTime.UtcNow;
                _monthlySpend = _recentTransactions
                    .Where(t => t.Type == WalletTransactionType.Debit && t.CreatedAt.Month == now.Month && t.CreatedAt.Year == now.Year)
                    .Sum(t => t.Amount);
                _monthlyPercent = _balance?.Balance > 0 ? (int)(_monthlySpend / (_monthlySpend + _balance.Balance) * 100) : 0;
            }
        }
        catch { }
    }
}
