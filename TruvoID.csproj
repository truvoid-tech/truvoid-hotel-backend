<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <!-- src/ folder still exists locally but belongs to the separate BE repo — exclude from FE compilation -->
        <Compile Remove="src\**" />
        <Content Remove="src\**" />
        <EmbeddedResource Remove="src\**" />
        <None Remove="src\**" />

        <!-- Include Admin DTOs from backend so frontend pages can use them for API deserialization -->
        <Compile Include="src\TruvoID.API\TruvoID.Core\DTOs\AdminDtos.cs" Link="DTOs\AdminDtos.cs" />
        <Compile Include="src\TruvoID.API\TruvoID.Core\DTOs\NimcConfigDtos.cs" Link="DTOs\NimcConfigDtos.cs" />

        <!-- tests/ folder is a separate xunit project — exclude from FE compilation -->
        <Compile Remove="tests\**" />
        <Content Remove="tests\**" />
        <EmbeddedResource Remove="tests\**" />
        <None Remove="tests\**" />
    </ItemGroup>

</Project>
